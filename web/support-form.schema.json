{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coffee Wolves customer support request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "customerUid",
    "customerEmail",
    "supportCategory",
    "subject",
    "details"
  ],
  "properties": {
    "customerUid": {
      "type": "string",
      "minLength": 1,
      "description": "Firebase Auth UID of the signed-in customer."
    },
    "customerEmail": {
      "type": "string",
      "format": "email"
    },
    "supportCategory": {
      "type": "string",
      "enum": [
        "Mi Bitácora",
        "Wolves Member Card",
        "Billetera",
        "Mis Coleccionables",
        "Álbum Cold Brew",
        "Mis Mascotas",
        "Mis Pedidos",
        "Otro"
      ]
    },
    "subject": {
      "type": "string",
      "minLength": 4,
      "maxLength": 120
    },
    "details": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000
    },
    "attachmentBase64": {
      "type": "string",
      "maxLength": 600000,
      "description": "Optional optimized JPEG screenshot, Base64 encoded."
    },
    "attachmentContentType": {
      "const": "image/jpeg"
    },
    "attachmentName": {
      "type": "string",
      "maxLength": 120
    }
  },
  "dependentRequired": {
    "attachmentBase64": [
      "attachmentContentType",
      "attachmentName"
    ]
  }
}

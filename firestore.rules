        && request.resource.data.keys().hasOnly([
          'fullName', 'phone', 'nationalId', 'email', 'memberCardNumber',
          'sequence', 'createdBy', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'fullName', 'phone', 'nationalId', 'email', 'memberCardNumber',
          'sequence', 'createdBy', 'createdAt'
        ])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 8
        && request.resource.data.phone.size() <= 24
        && request.resource.data.phone.matches(
          '^([+][0-9]{8,15}|[0-9]{8,15})$'
        )
        && request.resource.data.nationalId is string
        && request.resource.data.nationalId.size() >= 4
        && request.resource.data.nationalId.size() <= 32
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && request.resource.data.memberCardNumber is string
        && request.resource.data.memberCardNumber.matches('^CW-M-[0-9]{6}$')
        && request.resource.data.sequence is int
        && request.resource.data.sequence > 0
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(
          /databases/$(database)/documents/customerMemberCardLookups/$(request.resource.data.memberCardNumber)
        ).data.holderId == holderId
        && getAfter(
          /databases/$(database)/documents/customerMemberCardCounters/current
        ).data.lastSequence == request.resource.data.sequence
        && getAfter(
          /databases/$(database)/documents/customerMemberCardCounters/current
        ).data.lastCardNumber == request.resource.data.memberCardNumber;

      allow update, delete: if isAdmin();
    }

    match /customerMemberCardLookups/{cardNumber} {
      allow get: if isVerifiedStaff() || isAdmin();
      allow list: if false;

      allow create: if isVerifiedStaff()
        && request.resource.data.keys().hasOnly([
          'customerId', 'holderId', 'cardNumber', 'sequence',
          'createdBy', 'createdAt'
        ])
        && (
          request.resource.data.keys().hasAll(['customerId'])
            && !request.resource.data.keys().hasAny(['holderId'])
          || request.resource.data.keys().hasAll(['holderId'])
            && !request.resource.data.keys().hasAny(['customerId'])
        )
        && request.resource.data.cardNumber == cardNumber
        && cardNumber.matches('^CW-M-[0-9]{6}$')
        && request.resource.data.sequence is int
        && request.resource.data.sequence > 0
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && (
          request.resource.data.keys().hasAny(['customerId'])
            && request.resource.data.customerId is string
            && memberCardHolderMatches(
              request.resource.data.customerId,
              cardNumber,
              request.resource.data.sequence,
              request.auth.uid
            )
          || request.resource.data.keys().hasAny(['holderId'])
            && request.resource.data.holderId is string
            && memberCardHolderMatches(
              request.resource.data.holderId,
              cardNumber,
              request.resource.data.sequence,
              request.auth.uid
            )
        )
        && getAfter(
          /databases/$(database)/documents/customerMemberCardCounters/current
        ).data.lastSequence == request.resource.data.sequence
        && getAfter(
          /databases/$(database)/documents/customerMemberCardCounters/current
        ).data.lastCardNumber == cardNumber;

      allow update, delete: if false;
    }

    match /customerMemberCardCounters/{counterId} {
      allow get: if isVerifiedStaff() && counterId == 'current';
      allow list: if false;

      allow create: if isVerifiedStaff()
        && counterId == 'current'
        && request.resource.data.keys().hasOnly([
          'lastSequence', 'lastCardNumber'
        ])
        && request.resource.data.lastSequence == 1
        && request.resource.data.lastCardNumber.matches('^CW-M-[0-9]{6}$')
        && memberCardHolderLookupMatches(
          request.resource.data.lastCardNumber,
          request.resource.data.lastSequence
        );

      allow update: if isVerifiedStaff()
        && counterId == 'current'
        && request.resource.data.keys().hasOnly([
          'lastSequence', 'lastCardNumber'
        ])
        && resource.data.lastSequence is int
        && request.resource.data.lastSequence == resource.data.lastSequence + 1
        && request.resource.data.lastCardNumber.matches('^CW-M-[0-9]{6}$')
        && memberCardHolderLookupMatches(
          request.resource.data.lastCardNumber,
          request.resource.data.lastSequence
        );

      allow delete: if false;
    }

    match /staffAccessRequests/{userId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email is string
        && request.resource.data.keys().hasOnly([
          'email', 'displayName', 'username', 'birthDate', 'requestedRole',
          'status', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'email', 'displayName', 'username', 'birthDate', 'requestedRole',
          'status', 'createdAt'
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-zA-Z0-9._-]{3,20}$')
        && existsAfter(
          /databases/$(database)/documents/usernameRegistry/$(request.resource.data.username.lower())
        )
        && getAfter(
          /databases/$(database)/documents/usernameRegistry/$(request.resource.data.username.lower())
        ).data.uid == userId
        && getAfter(
          /databases/$(database)/documents/usernameRegistry/$(request.resource.data.username.lower())
        ).data.role == 'staff'
        && request.resource.data.birthDate is string
        && request.resource.data.requestedRole
          in ['barista', 'cajero']
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      allow update: if (
          request.auth != null
          && request.auth.uid == userId
          && resource.data.status == 'pending'
          && request.auth.token.email is string
          && request.resource.data.keys().hasOnly([
            'email', 'displayName', 'username', 'birthDate', 'requestedRole',
            'status', 'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'email', 'displayName', 'username', 'birthDate', 'requestedRole',
            'status', 'createdAt'
          ])
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.username is string
          && request.resource.data.username.matches('^[a-zA-Z0-9._-]{3,20}$')
          && existsAfter(
            /databases/$(database)/documents/usernameRegistry/$(request.resource.data.username.lower())
          )
          && getAfter(
            /databases/$(database)/documents/usernameRegistry/$(request.resource.data.username.lower())
          ).data.uid == userId
          && getAfter(
            /databases/$(database)/documents/usernameRegistry/$(request.resource.data.username.lower())
          ).data.role == 'staff'
          && request.resource.data.birthDate is string
          && request.resource.data.requestedRole
            in ['barista', 'cajero']
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time
        ) || (
          isAdmin()
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'reviewedAt', 'reviewedBy'])
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.reviewedAt == request.time
          && request.resource.data.reviewedBy == request.auth.uid
        );

      allow get: if request.auth != null
        && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow delete: if isAdmin() && resource.data.status == 'rejected';
    }

    match /managementMessages/{messageId} {
      allow get, list: if isAdmin();

      allow create: if isVerifiedStaff()
        && request.resource.data.keys().hasOnly([
          'senderUid', 'senderEmail', 'senderName', 'category', 'priority',
          'title', 'body', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'senderUid', 'senderEmail', 'senderName', 'category', 'priority',
          'title', 'body', 'createdAt'
        ])
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderEmail == request.auth.token.email
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() <= 120
        && request.resource.data.category in ['communication', 'directive']
        && request.resource.data.priority in ['normal', 'high']
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 4
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 8
        && request.resource.data.body.size() <= 3000
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    match /wolvesShopOrders/{orderId} {
      allow create: if false;

      allow get, list: if isAdmin();

      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'attended'
        && request.resource.data.attendedBy == request.auth.token.email
        && request.resource.data.attendedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'attendedAt', 'attendedBy'
        ]);

      allow delete: if false;
    }

    match /cafeSales/{saleId} {
      allow create: if isVerifiedStaff()
        && request.resource.data.keys().hasOnly([
          'employeeUid', 'employeeEmail', 'date', 'shift', 'attendanceId',
          'cashSessionId', 'paymentMethod', 'total', 'cashReceived',
          'changeDue', 'items', 'cafeItems', 'productQuantities',
          'shopProductQuantities', 'shopVariantQuantities', 'customerUid',
          'walletTransactionId', 'paidAt'
        ])
        && request.resource.data.keys().hasAll([
          'employeeUid', 'employeeEmail', 'date', 'shift', 'attendanceId',
          'cashSessionId', 'paymentMethod', 'total', 'cashReceived',
          'changeDue', 'items', 'cafeItems', 'productQuantities', 'paidAt'
        ])
        && request.resource.data.employeeUid == request.auth.uid
        && request.resource.data.employeeEmail == request.auth.token.email
        && request.resource.data.date is string
        && request.resource.data.shift in ['morning', 'afternoon', 'night']
        && request.resource.data.attendanceId
          == request.resource.data.date + '_' + request.auth.uid
        && request.resource.data.cashSessionId
          == request.resource.data.date + '_' + request.auth.uid
            + '_' + request.resource.data.shift
        && exists(
          /databases/$(database)/documents/staffShifts/$(request.resource.data.attendanceId)
        )
        && get(
          /databases/$(database)/documents/staffShifts/$(request.resource.data.attendanceId)
        ).data.shift == request.resource.data.shift
        && exists(
          /databases/$(database)/documents/staffAttendance/$(request.resource.data.attendanceId)
        )
        && get(
          /databases/$(database)/documents/staffAttendance/$(request.resource.data.attendanceId)
        ).data.clockOutAt == null
        && exists(
          /databases/$(database)/documents/cashSessions/$(request.resource.data.cashSessionId)
        )
        && get(
          /databases/$(database)/documents/cashSessions/$(request.resource.data.cashSessionId)
        ).data.status == 'open'
        && get(
          /databases/$(database)/documents/cashSessions/$(request.resource.data.cashSessionId)
        ).data.employeeUid == request.auth.uid
        && request.resource.data.paymentMethod in [
          'cash', 'qr', 'card', 'wallet'
        ]
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.cashReceived is number
        && request.resource.data.changeDue is number
        && (
          request.resource.data.paymentMethod == 'cash'
            && request.resource.data.cashReceived >= request.resource.data.total
            && request.resource.data.changeDue
              == request.resource.data.cashReceived - request.resource.data.total
          || request.resource.data.paymentMethod in ['qr', 'card']
            && request.resource.data.cashReceived == 0
            && request.resource.data.changeDue == 0
          || request.resource.data.paymentMethod == 'wallet'
            && request.resource.data.cashReceived == 0
            && request.resource.data.changeDue == 0
            && request.resource.data.customerUid is string
            && request.resource.data.walletTransactionId == saleId
            && existsAfter(walletTransactionPath(saleId))
            && getAfter(walletTransactionPath(saleId)).data.type == 'posDebit'
            && getAfter(walletTransactionPath(saleId)).data.ownerUid
              == request.resource.data.customerUid
            && getAfter(walletTransactionPath(saleId)).data.amount
              == request.resource.data.total
            && getAfter(walletPath(request.resource.data.customerUid)).data.lastTransactionId
              == saleId
        )
        && (
          request.resource.data.paymentMethod == 'wallet'
            && 'walletTransactionId' in request.resource.data
          || request.resource.data.paymentMethod != 'wallet'
            && !('walletTransactionId' in request.resource.data)
        )
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 30
        && request.resource.data.cafeItems is list
        && request.resource.data.cafeItems.size() <= 30
        && request.resource.data.productQuantities is map
        && (
          !('shopProductQuantities' in request.resource.data)
          || request.resource.data.shopProductQuantities is map
        )
        && (
          !('shopVariantQuantities' in request.resource.data)
          || request.resource.data.shopVariantQuantities is map
        )
        && request.resource.data.paidAt == request.time
        && (
          !('customerUid' in request.resource.data)
          || request.resource.data.customerUid is string
            && exists(
              /databases/$(database)/documents/users/$(request.resource.data.customerUid)
            )
        );

      allow get, list: if isAdmin();
      allow update, delete: if false;

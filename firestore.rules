        && getAfter(
          /databases/$(database)/documents/cafeSales/$(orderId)
        ).data.employeeUid == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/cafeSales/$(orderId)
        ).data.employeeEmail == request.auth.token.email
        && getAfter(
          /databases/$(database)/documents/cafeSales/$(orderId)
        ).data.shift == request.resource.data.shift
        && getAfter(
          /databases/$(database)/documents/cafeSales/$(orderId)
        ).data.cashSessionId == request.resource.data.cashSessionId
        && getAfter(
          /databases/$(database)/documents/cafeSales/$(orderId)
        ).data.paymentMethod == request.resource.data.paymentMethod
        && getAfter(
          /databases/$(database)/documents/cafeSales/$(orderId)
        ).data.total == request.resource.data.total
        && getAfter(
          /databases/$(database)/documents/cafeSales/$(orderId)
        ).data.items == request.resource.data.saleItems
        && getAfter(
          /databases/$(database)/documents/cafeSales/$(orderId)
        ).data.paidAt == request.time
        && getAfter(
          /databases/$(database)/documents/cafeSales/$(orderId)
        ).data.cafeItems == request.resource.data.items;

      allow update: if isVerifiedStaff()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'acknowledged'
        && request.resource.data.acknowledgedBy == request.auth.uid
        && request.resource.data.acknowledgedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'acknowledgedAt', 'acknowledgedBy'
        ]);

      allow delete: if false;

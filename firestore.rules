          'cashSessionId', 'paymentMethod', 'total', 'items', 'saleItems',
          'status', 'createdAt', 'tableNumber'
        ])
        && request.resource.data.keys().hasAll([
          'saleId', 'employeeUid', 'employeeEmail', 'shift',
          'cashSessionId', 'paymentMethod', 'total', 'items', 'saleItems',
          'status', 'createdAt'
        ])
        && request.resource.data.saleId == orderId
        && request.resource.data.employeeUid == request.auth.uid
        && request.resource.data.employeeEmail == request.auth.token.email
        && request.resource.data.shift in ['morning', 'afternoon', 'night']
        && request.resource.data.cashSessionId is string
        && request.resource.data.paymentMethod in [
          'cash', 'qr', 'card', 'wallet'
        ]
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.saleItems is list
        && request.resource.data.saleItems.size() > 0
        && request.resource.data.saleItems.size() <= 30
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 30
        && request.resource.data.status
          == (request.resource.data.items.size() == 0
            ? 'confirmed'
            : 'pending')
        && request.resource.data.createdAt == request.time
        && (
          !('tableNumber' in request.resource.data)
          || request.resource.data.tableNumber is int
            && request.resource.data.tableNumber >= 1
            && request.resource.data.tableNumber <= 8
        )
        && existsAfter(
          /databases/$(database)/documents/cafeSales/$(orderId)

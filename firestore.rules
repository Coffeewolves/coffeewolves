      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'employeeUid', 'employeeEmail', 'date', 'shift',
          'assignedBy', 'assignedAt'
        ])
        && request.resource.data.keys().hasAll([
          'employeeUid', 'employeeEmail', 'date', 'shift',
          'assignedBy', 'assignedAt'
        ])
        && assignmentId
          == request.resource.data.date + '_' + request.resource.data.employeeUid
        && request.resource.data.employeeUid is string
        && request.resource.data.employeeEmail is string
        && request.resource.data.date is string
        && request.resource.data.shift in ['morning', 'afternoon', 'night']
        && request.resource.data.assignedBy == request.auth.uid
        && request.resource.data.assignedAt == request.time;

      allow delete: if isAdmin();
    }

    match /staffAttendance/{attendanceId} {
      allow get: if isAdmin()
        || (request.auth != null
          && resource.data.employeeUid == request.auth.uid);
      allow list: if isAdmin();

      allow create: if isVerifiedStaff()
        && request.resource.data.keys().hasOnly([
          'employeeUid', 'date', 'shift', 'clockInAt', 'clockOutAt'
        ])
        && attendanceId == request.resource.data.date + '_' + request.auth.uid
        && request.resource.data.employeeUid == request.auth.uid
        && request.resource.data.date is string
        && request.resource.data.shift in ['morning', 'afternoon', 'night']
        && exists(
          /databases/$(database)/documents/staffShifts/$(attendanceId)
        )
        && get(
          /databases/$(database)/documents/staffShifts/$(attendanceId)
        ).data.shift == request.resource.data.shift
        && request.resource.data.clockInAt == request.time
        && request.resource.data.clockOutAt == null;

      allow update: if isVerifiedStaff()
        && resource.data.employeeUid == request.auth.uid
        && resource.data.clockOutAt == null
        && get(
          /databases/$(database)/documents/cashSessions/$(resource.data.date + '_' + request.auth.uid + '_' + resource.data.shift)
        ).data.status == 'closed'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['clockOutAt'])
        && request.resource.data.clockOutAt == request.time;

      allow delete: if false;
    }

    match /cashSessions/{sessionId} {
      allow get: if isAdmin()
        || (request.auth != null
          && resource.data.employeeUid == request.auth.uid);
      allow list: if isAdmin();

      allow create: if isVerifiedStaff()
        && request.resource.data.keys().hasOnly([
          'employeeUid', 'date', 'shift', 'openingAmount', 'openedAt',
          'status', 'closedAt', 'countedAmount', 'closedBy'
        ])
        && sessionId == request.resource.data.date + '_'
          + request.auth.uid + '_' + request.resource.data.shift
        && request.resource.data.employeeUid == request.auth.uid
        && request.resource.data.date is string
        && request.resource.data.shift in ['morning', 'afternoon', 'night']
        && request.resource.data.openingAmount is number
        && request.resource.data.openingAmount >= 0
        && request.resource.data.openedAt == request.time
        && request.resource.data.status == 'open'
        && request.resource.data.closedAt == null
        && request.resource.data.countedAmount == null
        && request.resource.data.closedBy == null
        && exists(
          /databases/$(database)/documents/staffAttendance/$(request.resource.data.date + '_' + request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/staffAttendance/$(request.resource.data.date + '_' + request.auth.uid)
        ).data.clockOutAt == null;

      allow update: if isVerifiedStaff()
        && resource.data.employeeUid == request.auth.uid
        && resource.data.status == 'open'
        && request.resource.data.status == 'closed'
        && request.resource.data.closedAt == request.time
        && request.resource.data.closedBy == request.auth.uid
        && request.resource.data.countedAmount is number
        && request.resource.data.countedAmount >= 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'closedAt', 'countedAmount', 'closedBy'
        ]);

      allow delete: if false;
    }

    match /customerComplaints/{complaintId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'customerUid', 'customerEmail', 'shift', 'incident',
          'feedbackType', 'orderId', 'details', 'autoReply',
          'statusMessage', 'createdAt', 'status', 'supportCategory',
          'subject', 'attachmentBase64', 'attachmentContentType',
          'attachmentName'
        ])
        && request.resource.data.keys().hasAll([
          'customerUid', 'customerEmail', 'shift', 'feedbackType', 'incident',
          'details', 'autoReply', 'statusMessage', 'createdAt', 'status'
        ])
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.customerEmail == request.auth.token.email
        && request.auth.token.email_verified == true
        && request.resource.data.shift in ['morning', 'afternoon', 'night']
        && request.resource.data.feedbackType
          in ['suggestion', 'compliment', 'complaint']
        && request.resource.data.autoReply
          == (
            request.resource.data.feedbackType == 'suggestion'
              ? 'Gracias por compartir tu sugerencia. Gerencia la recibió y la revisará.'
              : request.resource.data.feedbackType == 'compliment'
                ? 'Gracias por tu felicitación. Nos alegra compartir la experiencia Coffee Wolves contigo.'
                : 'Recibimos tu reclamo. Gerencia revisará el caso y podrás consultar aquí su estado.'
          )
        && request.resource.data.statusMessage
          == 'Tu mensaje fue recibido y está pendiente de revisión.'
        && request.resource.data.incident is string
        && (
          !('supportCategory' in request.resource.data)
          || request.resource.data.supportCategory in [
            'Mi Bitácora', 'Wolves Member Card', 'Billetera',
            'Mis Coleccionables', 'Álbum Cold Brew', 'Mis Mascotas',
            'Mis Pedidos', 'Otro'
          ]
        )
        && (
          !('subject' in request.resource.data)
          || request.resource.data.subject is string
            && request.resource.data.subject.size() >= 4
            && request.resource.data.subject.size() <= 120
        )
        && (
          !('attachmentBase64' in request.resource.data)
          && !('attachmentContentType' in request.resource.data)
          && !('attachmentName' in request.resource.data)
          || 'attachmentBase64' in request.resource.data
            && request.resource.data.attachmentBase64 is string
            && request.resource.data.attachmentBase64.size() <= 600000
            && request.resource.data.attachmentContentType == 'image/jpeg'
            && request.resource.data.attachmentName is string
            && request.resource.data.attachmentName.size() <= 120
        )
        && (!('orderId' in request.resource.data)
          || request.resource.data.orderId is string
            && request.resource.data.orderId.size() <= 100)
        && request.resource.data.details is string
        && request.resource.data.details.size() >= 10
        && request.resource.data.details.size() <= 2000
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'new';

      allow get, list: if isAdmin()
        || (request.auth != null
          && resource.data.customerUid == request.auth.uid);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'statusMessage'])
        && request.resource.data.status in ['new', 'reviewing', 'resolved']
        && request.resource.data.statusMessage
          == (
            request.resource.data.status == 'new'
              ? 'Tu mensaje fue recibido y está pendiente de revisión.'
              : request.resource.data.status == 'reviewing'
                ? 'Gerencia está revisando tu mensaje. Te avisaremos aquí cuando haya una actualización.'
                : 'Gerencia marcó tu caso como resuelto. Si aún necesitas ayuda, envía otro mensaje.'
          );
      allow delete: if false;
    }

    match /passportTastingNotes/{noteId} {
      allow get: if request.auth != null
        && noteId.matches('^' + request.auth.uid + '__.*$');
      allow list: if false;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'methodName', 'notes', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'ownerUid', 'methodName', 'notes', 'updatedAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && validPassportMethod(request.resource.data.methodName)
        && noteId
          == request.auth.uid + '__' + request.resource.data.methodName
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 2000
        && request.resource.data.updatedAt == request.time;

      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.methodName == resource.data.methodName
        && validPassportMethod(request.resource.data.methodName)
        && noteId
          == request.auth.uid + '__' + request.resource.data.methodName
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 2000
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['notes', 'updatedAt']);

      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    match /passportProgress/{customerUid} {
      allow get: if request.auth != null
        && (request.auth.uid == customerUid || isVerifiedStaff() || isAdmin());
      allow list: if isAdmin();

      allow create: if isVerifiedStaff()
        && hasActiveMemberCard(customerUid)
        && request.resource.data.keys().hasOnly([
          'customerUid', 'completedMethods', 'completedCount', 'rewardClaimed',
          'updatedBy', 'updatedAt', 'lastStampId', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'customerUid', 'completedMethods', 'completedCount',
          'rewardClaimed', 'updatedBy', 'updatedAt', 'lastStampId',
          'createdAt'
        ])
        && request.resource.data.customerUid == customerUid
        && request.resource.data.completedMethods is list
        && request.resource.data.completedMethods.size() == 1
        && validPassportMethod(request.resource.data.completedMethods[0])
        && request.resource.data.completedCount == 1
        && request.resource.data.rewardClaimed == false
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastStampId is string
        && passportStampMatches(
          request.resource.data.lastStampId,
          customerUid,
          request.resource.data.completedMethods[0]
        );

      allow update: if isVerifiedStaff()
        && hasActiveMemberCard(customerUid)
        && request.resource.data.customerUid == customerUid
        && (
          resource.data.rewardClaimed == false
          && request.resource.data.rewardClaimed == false
          && request.resource.data.completedMethods is list
          && request.resource.data.completedMethods.size()
            == resource.data.completedMethods.size() + 1
          && request.resource.data.completedMethods.hasAll(
            resource.data.completedMethods
          )
          && !resource.data.completedMethods.hasAny([
            request.resource.data.completedMethods[
              request.resource.data.completedMethods.size() - 1
            ]
          ])
          && request.resource.data.completedCount
            == resource.data.completedCount + 1
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && request.resource.data.lastStampId is string
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'completedMethods', 'completedCount', 'updatedBy',
            'updatedAt', 'lastStampId'
          ])
          && passportStampMatches(
            request.resource.data.lastStampId,
            customerUid,
            request.resource.data.completedMethods[
              request.resource.data.completedMethods.size() - 1
            ]
          )
          || resource.data.completedCount == 9
            && resource.data.rewardClaimed == false
            && completePassport(resource.data.completedMethods)
            && request.resource.data.rewardClaimed == true
            && request.resource.data.rewardMugCode is string
            && request.resource.data.rewardClaimedBy == request.auth.uid
            && request.resource.data.rewardClaimedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'rewardClaimed', 'rewardMugCode',
                'rewardClaimedBy', 'rewardClaimedAt'
              ])
            && getAfter(
              /databases/$(database)/documents/legendaryMugRedemptions/$(request.resource.data.rewardMugCode)
            ).data.customerUid == customerUid
            && getAfter(
              /databases/$(database)/documents/legendaryMugRedemptions/$(request.resource.data.rewardMugCode)
            ).data.employeeUid == request.auth.uid
        );

      allow delete: if false;
    }

    match /passportMethodStamps/{stampId} {
      allow create: if isVerifiedStaff()
        && request.resource.data.keys().hasOnly([
          'customerUid', 'employeeUid', 'employeeEmail',
          'methodName', 'stampedAt'
        ])
        && request.resource.data.customerUid is string
        && request.resource.data.employeeUid == request.auth.uid
        && request.resource.data.employeeEmail == request.auth.token.email
        && validPassportMethod(request.resource.data.methodName)
        && request.resource.data.stampedAt == request.time
        && getAfter(
          /databases/$(database)/documents/passportProgress/$(request.resource.data.customerUid)
        ).data.lastStampId == stampId
        && getAfter(
          /databases/$(database)/documents/passportProgress/$(request.resource.data.customerUid)
        ).data.completedMethods.hasAny([request.resource.data.methodName]);

      allow get, list: if isAdmin();
      allow update, delete: if false;
    }

    match /legendaryMugRedemptions/{mugCode} {
      allow create: if isVerifiedStaff()
        && request.resource.data.keys().hasOnly([
          'customerUid', 'employeeUid', 'employeeEmail', 'mugCode',
          'redeemedAt'
        ])
        && request.resource.data.customerUid is string
        && request.resource.data.employeeUid == request.auth.uid
        && request.resource.data.employeeEmail == request.auth.token.email
        && request.resource.data.mugCode == mugCode
        && mugCode.matches('^[A-Z0-9-]{4,80}$')
        && request.resource.data.redeemedAt == request.time
        && getAfter(
          /databases/$(database)/documents/passportProgress/$(request.resource.data.customerUid)
        ).data.completedCount == 9
        && completePassport(getAfter(
          /databases/$(database)/documents/passportProgress/$(request.resource.data.customerUid)
        ).data.completedMethods)
        && getAfter(
          /databases/$(database)/documents/passportProgress/$(request.resource.data.customerUid)
        ).data.rewardClaimed == true
        && getAfter(
          /databases/$(database)/documents/passportProgress/$(request.resource.data.customerUid)
        ).data.rewardMugCode == mugCode;

      allow get, list: if isAdmin();
      allow update, delete: if false;
    }

    match /products/{productId} {
      allow read: if request.auth != null || resource.data.isVisible == true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'category', 'family', 'description', 'price',
          'stock', 'stockBySize', 'isVisible', 'lastSaleId', 'sku'
        ])
        && request.resource.data.keys().hasAll([
          'id', 'name', 'category', 'price', 'stock', 'isVisible'
        ])
        && request.resource.data.id == productId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.category in [
          'food', 'beverage', 'beverages', 'smoothies', 'combos_pack',
          'comida', 'bebida', 'pet_friendly',
          'merch', 'merchandising', 'merch_wolves_shop', 'wolves_shop',
          'moda_alfa', 'accesorios', 'estilo_de_vida', 'taza', 'tazas',
          'tazas_coleccionables', 'coleccionables', 'collectibles', 'metodos'
        ]
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && validShopSizeStock(request.resource.data)
        && request.resource.data.isVisible is bool
        && (
          !('family' in request.resource.data)
          || request.resource.data.family is string
        )
        && (
          !('description' in request.resource.data)
          || request.resource.data.description is string
        )
        && (
          !('lastSaleId' in request.resource.data)
          || request.resource.data.lastSaleId is string
        )
        && (
          !('sku' in request.resource.data)
          || request.resource.data.sku is string
            && request.resource.data.sku.size() <= 64
        );
      allow update: if (
        isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'category', 'family', 'description', 'price',
          'stock', 'stockBySize', 'isVisible', 'sku'
        ])
        && (
          !('id' in request.resource.data)
          || request.resource.data.id == productId
        )
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.category in [
          'food', 'beverage', 'beverages', 'smoothies', 'combos_pack',
          'comida', 'bebida', 'pet_friendly',
          'merch', 'merchandising', 'merch_wolves_shop', 'wolves_shop',
          'moda_alfa', 'accesorios', 'estilo_de_vida', 'taza', 'tazas',
          'tazas_coleccionables', 'coleccionables', 'collectibles', 'metodos'
        ]
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && validShopSizeStock(request.resource.data)
        && request.resource.data.isVisible is bool
        && (
          !('family' in request.resource.data)
          || request.resource.data.family is string
        )
        && (
          !('description' in request.resource.data)
          || request.resource.data.description is string
        )
        && (
          !('sku' in request.resource.data)
          || request.resource.data.sku is string
            && request.resource.data.sku.size() <= 64
        )
      ) || (
        isVerifiedStaff()
        && resource.data.family == 'Merch Wolves Shop'
        && resource.data.isVisible == true
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['stock', 'stockBySize', 'lastSaleId'])
        && resource.data.stock is int
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock
        && request.resource.data.lastSaleId is string
        && getAfter(
          /databases/$(database)/documents/cafeSales/$(request.resource.data.lastSaleId)
        ).data.employeeUid == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/cafeSales/$(request.resource.data.lastSaleId)
        ).data.shopProductQuantities[productId]
          == resource.data.stock - request.resource.data.stock
        && (
          !('stockBySize' in resource.data)
            && !('stockBySize' in request.resource.data)
          || 'stockBySize' in resource.data
            && 'stockBySize' in request.resource.data
            && validShopSizeStock(request.resource.data)
            && getAfter(
              /databases/$(database)/documents/cafeSales/$(request.resource.data.lastSaleId)
            ).data.shopVariantQuantities[productId] is map
            && getAfter(
              /databases/$(database)/documents/cafeSales/$(request.resource.data.lastSaleId)
            ).data.shopVariantQuantities[productId].get('S', 0) is int
            && getAfter(
              /databases/$(database)/documents/cafeSales/$(request.resource.data.lastSaleId)
            ).data.shopVariantQuantities[productId].get('S', 0) >= 0
            && getAfter(
              /databases/$(database)/documents/cafeSales/$(request.resource.data.lastSaleId)
            ).data.shopVariantQuantities[productId].get('M', 0) is int
            && getAfter(
              /databases/$(database)/documents/cafeSales/$(request.resource.data.lastSaleId)
            ).data.shopVariantQuantities[productId].get('M', 0) >= 0
            && getAfter(
              /databases/$(database)/documents/cafeSales/$(request.resource.data.lastSaleId)
            ).data.shopVariantQuantities[productId].get('L', 0) is int
            && getAfter(
              /databases/$(database)/documents/cafeSales/$(request.resource.data.lastSaleId)
            ).data.shopVariantQuantities[productId].get('L', 0) >= 0
            && getAfter(
              /databases/$(database)/documents/cafeSales/$(request.resource.data.lastSaleId)
            ).data.shopVariantQuantities[productId].get('XL', 0) is int
            && getAfter(
              /databases/$(database)/documents/cafeSales/$(request.resource.data.lastSaleId)
            ).data.shopVariantQuantities[productId].get('XL', 0) >= 0
            && getAfter(
              /databases/$(database)/documents/cafeSales/$(request.resource.data.lastSaleId)
            ).data.shopVariantQuantities[productId].get('2XL', 0) is int
            && getAfter(
              /databases/$(database)/documents/cafeSales/$(request.resource.data.lastSaleId)
            ).data.shopVariantQuantities[productId].get('2XL', 0) >= 0
            && getAfter(
              /databases/$(database)/documents/cafeSales/$(request.resource.data.lastSaleId)
            ).data.shopVariantQuantities[productId].get('3XL', 0) is int
            && getAfter(
              /databases/$(database)/documents/cafeSales/$(request.resource.data.lastSaleId)
            ).data.shopVariantQuantities[productId].get('3XL', 0) >= 0
            && request.resource.data.stockBySize.get('S', 0)
              == resource.data.stockBySize.get('S', 0)
                - getAfter(
                  /databases/$(database)/documents/cafeSales/$(request.resource.data.lastSaleId)
                ).data.shopVariantQuantities[productId].get('S', 0)
            && request.resource.data.stockBySize.get('M', 0)
              == resource.data.stockBySize.get('M', 0)
                - getAfter(
                  /databases/$(database)/documents/cafeSales/$(request.resource.data.lastSaleId)
                ).data.shopVariantQuantities[productId].get('M', 0)
            && request.resource.data.stockBySize.get('L', 0)
              == resource.data.stockBySize.get('L', 0)
                - getAfter(
                  /databases/$(database)/documents/cafeSales/$(request.resource.data.lastSaleId)
                ).data.shopVariantQuantities[productId].get('L', 0)
            && request.resource.data.stockBySize.get('XL', 0)
              == resource.data.stockBySize.get('XL', 0)
                - getAfter(
                  /databases/$(database)/documents/cafeSales/$(request.resource.data.lastSaleId)
                ).data.shopVariantQuantities[productId].get('XL', 0)
            && request.resource.data.stockBySize.get('2XL', 0)
              == resource.data.stockBySize.get('2XL', 0)
                - getAfter(
                  /databases/$(database)/documents/cafeSales/$(request.resource.data.lastSaleId)
                ).data.shopVariantQuantities[productId].get('2XL', 0)
            && request.resource.data.stockBySize.get('3XL', 0)
              == resource.data.stockBySize.get('3XL', 0)
                - getAfter(
                  /databases/$(database)/documents/cafeSales/$(request.resource.data.lastSaleId)
                ).data.shopVariantQuantities[productId].get('3XL', 0)
        )
      );
      allow delete: if isAdmin();
    }

    match /cafeCatalog/{productId} {
      allow read: if request.auth != null;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'name', 'category', 'description', 'price', 'stock',
          'stockTracked', 'isAvailable', 'isVisible', 'isDeleted', 'updatedBy',
          'updatedAt', 'familyId', 'familyName', 'imageUrl', 'hasImage',
          'inventorySource'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'category', 'description', 'price', 'stock',
          'stockTracked', 'isAvailable', 'isVisible', 'isDeleted',
          'updatedBy', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.category is string
        && request.resource.data.description is string
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stockTracked is bool
        && request.resource.data.isAvailable is bool
        && request.resource.data.isVisible is bool
        && request.resource.data.isDeleted is bool
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && (!('familyId' in request.resource.data)
          || request.resource.data.familyId is string)
        && (!('familyName' in request.resource.data)
          || request.resource.data.familyName is string)
        && (!('imageUrl' in request.resource.data)
          || request.resource.data.imageUrl is string)
        && (!('hasImage' in request.resource.data)
          || request.resource.data.hasImage is bool)
        && (!('inventorySource' in request.resource.data)
          || request.resource.data.inventorySource == 'products');

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'category', 'description', 'price', 'stock',
          'stockTracked', 'isAvailable', 'isVisible', 'isDeleted', 'updatedBy',
          'updatedAt', 'lastSaleId', 'familyId', 'familyName', 'imageUrl',
          'hasImage', 'family', 'inventorySource'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'category', 'description', 'price', 'stock',
          'stockTracked', 'isAvailable', 'isVisible', 'isDeleted',
          'updatedBy', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.category is string
        && request.resource.data.description is string
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stockTracked is bool
        && request.resource.data.isAvailable is bool
        && request.resource.data.isVisible is bool
        && request.resource.data.isDeleted is bool
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && (!('familyId' in request.resource.data)
          || !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['familyId'])
          || request.resource.data.familyId is string)
        && (!('familyName' in request.resource.data)
          || !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['familyName'])
          || request.resource.data.familyName is string)
        && (!('imageUrl' in request.resource.data)
          || !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['imageUrl'])
          || request.resource.data.imageUrl is string)
        && (!('hasImage' in request.resource.data)
          || !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['hasImage'])
          || request.resource.data.hasImage is bool)
        && (!('inventorySource' in request.resource.data)
          || !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['inventorySource'])
          || request.resource.data.inventorySource == 'products')
        || isVerifiedStaff()
          && resource.data.stockTracked == true
          && request.resource.data.stock is int
          && request.resource.data.stock >= 0
          && request.resource.data.stock < resource.data.stock
          && request.resource.data.lastSaleId is string
          && getAfter(
            /databases/$(database)/documents/cafeSales/$(request.resource.data.lastSaleId)
          ).data.employeeUid == request.auth.uid
          && getAfter(
            /databases/$(database)/documents/cafeSales/$(request.resource.data.lastSaleId)
          ).data.productQuantities[productId]
            == resource.data.stock - request.resource.data.stock
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['stock', 'lastSaleId']);

      allow delete: if isAdmin();
    }

    match /cafeFamilies/{familyId} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'name', 'isDeleted', 'updatedBy', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'isDeleted', 'updatedBy', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.isDeleted is bool
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /managementAnnouncements/{announcementId} {
      allow read: if isAdmin() || resource.data.isActive == true;

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'type', 'title', 'description', 'dateLabel', 'isActive',
          'createdAt', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.keys().hasAll([
          'type', 'title', 'description', 'isActive',
          'createdAt', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.type in ['promotion', 'event']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && (!('dateLabel' in request.resource.data)
          || request.resource.data.dateLabel is string
            && request.resource.data.dateLabel.size() <= 80)
        && request.resource.data.isActive is bool
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'type', 'title', 'description', 'dateLabel', 'isActive',
          'updatedAt', 'updatedBy'
        ])
        && request.resource.data.type in ['promotion', 'event']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && (!('dateLabel' in request.resource.data)
          || request.resource.data.dateLabel is string
            && request.resource.data.dateLabel.size() <= 80)
        && request.resource.data.isActive is bool
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;

      allow delete: if isAdmin();
    }

    match /wolvesShopFallbackExclusions/{productId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['isExcluded', 'updatedAt'])
        && request.resource.data.keys().hasAll(['isExcluded', 'updatedAt'])
        && request.resource.data.isExcluded == true
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /cafeMenuImages/{productId} {
      allow read: if request.auth != null
        || productId.matches('^wolves-shop-[A-Za-z0-9_-]+$');
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'imageBase64', 'contentType', 'updatedBy', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'imageBase64', 'contentType', 'updatedBy', 'updatedAt'
        ])
        && request.resource.data.imageBase64 is string
        && request.resource.data.imageBase64.size() <= 700000
        && request.resource.data.contentType == 'image/jpeg'
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /coldBrewAlbums/{customerUid} {
      function validFigureUpdate() {
        let previousFigures = resource.data.get('figures', []);
        let updatedFigures = request.resource.data.figures;
        let redemptionPath =
          /databases/$(database)/documents/rewardRedemptions/$(request.resource.data.lastRedemptionId);
        let figureId = getAfter(redemptionPath).data.figureId;
        return previousFigures is list
          && validColdBrewFigureList(updatedFigures)
          && updatedFigures.hasAll(previousFigures)
          && figureId in coldBrewFigureIds()
          && figureId in updatedFigures
          && updatedFigures.size() == previousFigures.size()
            + (figureId in previousFigures ? 0 : 1);
      }

      allow get: if request.auth != null
        && (request.auth.uid == customerUid || isVerifiedStaff() || isAdmin());
      allow list: if isAdmin();

      allow create: if isVerifiedStaff()
        && request.resource.data.keys().hasOnly([
          'customerUid', 'stamps', 'figures', 'updatedAt', 'updatedBy',
          'lastRedemptionId'
        ])
        && request.resource.data.customerUid == customerUid
        && request.resource.data.stamps == 1
        && validColdBrewFigureList(request.resource.data.figures)
        && request.resource.data.figures.size() == 1
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.lastRedemptionId is string
        && request.resource.data.figures[0]
          == getAfter(
            /databases/$(database)/documents/rewardRedemptions/$(request.resource.data.lastRedemptionId)
          ).data.figureId
        && auditMatches(
          request.resource.data.lastRedemptionId,
          customerUid,
          'coldBrewStamp',
          getAfter(
            /databases/$(database)/documents/rewardRedemptions/$(request.resource.data.lastRedemptionId)
          ).data.rewardId
        );

      allow update: if isVerifiedStaff()
        && request.resource.data.keys().hasOnly([
          'customerUid', 'stamps', 'figures', 'updatedAt', 'updatedBy',
          'lastRedemptionId'
        ])
        && request.resource.data.customerUid == customerUid
        && request.resource.data.stamps == resource.data.stamps + 1
        && validFigureUpdate()
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.lastRedemptionId is string
        && auditMatches(
          request.resource.data.lastRedemptionId,
          customerUid,
          'coldBrewStamp',
          getAfter(
            /databases/$(database)/documents/rewardRedemptions/$(request.resource.data.lastRedemptionId)
          ).data.rewardId
        );

      allow delete: if false;
    }

    match /coldBrewTastingNotes/{noteId} {
      allow get, list: if request.auth != null
        && (resource.data.customerUid == request.auth.uid
          || isVerifiedStaff() || isAdmin());
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.customerUid
        && request.resource.data.keys().hasOnly([
          'customerUid', 'flavorProfile', 'rating', 'createdAt'
        ])
        && request.resource.data.flavorProfile in [
          'chocolate', 'fruity', 'citrus', 'floral', 'nutty', 'smooth'
        ]
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /collectibleCharacters/{modelCode} {
      allow get: if isVerifiedStaff() || isAdmin();
      allow list: if isAdmin();

      allow create: if isVerifiedStaff()
        && modelCode.matches('^CW-(PLUSH-00[1-9]|CUP-00[7-9])$')
        && request.resource.data.keys().hasOnly([
          'modelCode', 'name', 'edition', 'createdAt', 'createdBy'
        ])
        && request.resource.data.modelCode == modelCode
        && validCollectibleModel(modelCode, request.resource.data.name)
        && request.resource.data.edition == 'Original Collection'
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;

      allow update, delete: if false;
    }

    match /collectiblePlushCounters/{modelCode} {
      allow get: if isVerifiedStaff() || isAdmin();
      allow list: if isAdmin();

      allow create: if isVerifiedStaff()
        && modelCode.matches('^CW-(PLUSH-00[1-9]|CUP-00[7-9])$')
        && request.resource.data.keys().hasOnly(['lastSequence'])
        && request.resource.data.lastSequence is int
        && request.resource.data.lastSequence >= 1
        && request.resource.data.lastSequence <= 8;

      allow update: if isVerifiedStaff()
        && modelCode.matches('^CW-(PLUSH-00[1-9]|CUP-00[7-9])$')
        && request.resource.data.keys().hasOnly(['lastSequence'])
        && resource.data.lastSequence is int
        && request.resource.data.lastSequence is int
        && request.resource.data.lastSequence > resource.data.lastSequence
        && request.resource.data.lastSequence <= resource.data.lastSequence + 8
        && request.resource.data.lastSequence <= 9999;

      allow delete: if false;
    }

    match /collectiblePlushes/{code} {
      allow get: if isVerifiedStaff()
        || isAdmin()
        || (request.auth != null && resource.data.claimedBy == request.auth.uid);
      allow list: if isVerifiedStaff() || isAdmin()
        || (request.auth != null
          && resource.data.claimedBy == request.auth.uid);

      allow create: if isVerifiedStaff()
        && request.resource.data.keys().hasOnly([
          'code', 'modelCode', 'character', 'serial', 'sequence', 'edition',
          'createdBy', 'createdAt', 'claimedBy', 'claimedAt',
          'inventoryStatus',
          'claimedByEmployee'
        ])
        && request.resource.data.code == code
        && code.matches('^CW-(PLUSH-00[1-9]|CUP-00[7-9])-[0-9]{4}$')
        && request.resource.data.modelCode is string
        && validCollectibleModel(
          request.resource.data.modelCode,
          request.resource.data.character
        )
        && code.matches(
          '^' + request.resource.data.modelCode + '-[0-9]{4}$'
        )
        && request.resource.data.serial is string
        && request.resource.data.serial.matches('^[0-9]{4}$')
        && request.resource.data.serial != '0000'
        && request.resource.data.sequence is int
        && request.resource.data.sequence > 0
        && code == request.resource.data.modelCode
          + '-' + request.resource.data.serial
        && request.resource.data.edition == 'Original Collection'
        && request.resource.data.inventoryStatus == 'IN_STOCK'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.claimedBy == null
        && request.resource.data.claimedAt == null
        && request.resource.data.claimedByEmployee == null
        && existsAfter(
          /databases/$(database)/documents/collectiblePlushCounters/$(request.resource.data.modelCode)
        )
        && getAfter(
          /databases/$(database)/documents/collectiblePlushCounters/$(request.resource.data.modelCode)
        ).data.lastSequence is int;

      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'code', 'modelCode', 'character', 'serial', 'sequence', 'edition',
          'createdBy', 'createdAt', 'claimedBy', 'claimedByName',
          'claimedAt', 'claimedByEmployee', 'pendingTransferId',
          'inventoryStatus'
        ])
        && (
          isVerifiedStaff()
            && resource.data.claimedBy == null
            && !exists(
              /databases/$(database)/documents/plushAdoptions/$(code)
            )
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'claimedBy', 'claimedByName', 'claimedAt', 'claimedByEmployee',
                'inventoryStatus'
              ])
            && (
              request.resource.data.claimedBy == null
              || request.resource.data.claimedBy is string
            )
            && (
              request.resource.data.claimedByName == null
              || request.resource.data.claimedByName is string
            )
            && request.resource.data.claimedAt == request.time
            && request.resource.data.claimedByEmployee == request.auth.uid
            && request.resource.data.inventoryStatus == 'ADOPTED'
            && (
              !('inventoryStatus' in resource.data)
              || resource.data.inventoryStatus == 'IN_STOCK'
            )
            && getAfter(
              /databases/$(database)/documents/plushAdoptions/$(code)
            ).data.code == code
          || request.auth.token.firebase.sign_in_provider != 'anonymous'
            && resource.data.claimedBy is string
            && resource.data.claimedBy == request.auth.uid
            && !('pendingTransferId' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['pendingTransferId'])
            && request.resource.data.pendingTransferId is string
            && getAfter(
              /databases/$(database)/documents/plushOwnershipTransfers/$(request.resource.data.pendingTransferId)
            ).data.fromUid == request.auth.uid
            && getAfter(
              /databases/$(database)/documents/plushOwnershipTransfers/$(request.resource.data.pendingTransferId)
            ).data.collectibleCode == code
            && getAfter(
              /databases/$(database)/documents/plushOwnershipTransfers/$(request.resource.data.pendingTransferId)
            ).data.status == 'pending'
          || request.auth.token.firebase.sign_in_provider != 'anonymous'
            && resource.data.pendingTransferId is string
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'claimedBy', 'claimedByName', 'pendingTransferId'
              ])
            && request.resource.data.claimedBy is string
            && request.resource.data.claimedByName == null
            && !('pendingTransferId' in request.resource.data)
            && getAfter(
              /databases/$(database)/documents/plushOwnershipTransfers/$(resource.data.pendingTransferId)
            ).data.status == 'accepted'
            && getAfter(
              /databases/$(database)/documents/plushOwnershipTransfers/$(resource.data.pendingTransferId)
            ).data.fromUid == resource.data.claimedBy
            && getAfter(
              /databases/$(database)/documents/plushOwnershipTransfers/$(resource.data.pendingTransferId)
            ).data.toUid == request.resource.data.claimedBy
            && request.auth.uid == request.resource.data.claimedBy
            && getAfter(
              /databases/$(database)/documents/plushOwnershipTransfers/$(resource.data.pendingTransferId)
            ).data.collectibleCode == code
          || request.auth.token.firebase.sign_in_provider != 'anonymous'
            && resource.data.pendingTransferId is string
            && resource.data.claimedBy == request.auth.uid
            && !('pendingTransferId' in request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['pendingTransferId'])
            && getAfter(
              /databases/$(database)/documents/plushOwnershipTransfers/$(resource.data.pendingTransferId)
            ).data.status in ['rejected', 'cancelled']
            && getAfter(
              /databases/$(database)/documents/plushOwnershipTransfers/$(resource.data.pendingTransferId)
            ).data.fromUid == request.auth.uid
            && getAfter(
              /databases/$(database)/documents/plushOwnershipTransfers/$(resource.data.pendingTransferId)
            ).data.collectibleCode == code
          || request.auth.token.firebase.sign_in_provider != 'anonymous'
            && resource.data.pendingTransferId is string
            && request.resource.data.claimedBy == resource.data.claimedBy
            && !('pendingTransferId' in request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['pendingTransferId'])
            && getAfter(
              /databases/$(database)/documents/plushOwnershipTransfers/$(resource.data.pendingTransferId)
            ).data.status == 'rejected'
            && getAfter(
              /databases/$(database)/documents/plushOwnershipTransfers/$(resource.data.pendingTransferId)
            ).data.toUid == request.auth.uid
            && getAfter(
              /databases/$(database)/documents/plushOwnershipTransfers/$(resource.data.pendingTransferId)
            ).data.fromUid == resource.data.claimedBy
            && getAfter(
              /databases/$(database)/documents/plushOwnershipTransfers/$(resource.data.pendingTransferId)
            ).data.collectibleCode == code
        );

      allow delete: if false;
    }

    match /plushAuthenticity/{code} {
      allow get: if true;
      allow list: if false;

      allow create: if isVerifiedStaff()
        && request.resource.data.keys().hasOnly([
          'code', 'modelCode', 'character', 'serial', 'sequence', 'edition',
          'status', 'registeredAt', 'adoptedAt'
        ])
        && request.resource.data.code == code
        && code.matches('^CW-(PLUSH-00[1-9]|CUP-00[7-9])-[0-9]{4}$')
        && validCollectibleModel(
          request.resource.data.modelCode,
          request.resource.data.character
        )
        && request.resource.data.serial is string
        && request.resource.data.serial.matches('^[0-9]{4}$')
        && request.resource.data.sequence is int
        && code == request.resource.data.modelCode
          + '-' + request.resource.data.serial
        && request.resource.data.edition == 'Original Collection'
        && request.resource.data.status == 'available'
        && request.resource.data.registeredAt == request.time
        && request.resource.data.adoptedAt == null
        && getAfter(
          /databases/$(database)/documents/collectiblePlushes/$(code)
        ).data.code == code
        && getAfter(
          /databases/$(database)/documents/collectiblePlushes/$(code)
        ).data.claimedBy == null;

      allow update: if isVerifiedStaff()
        && resource.data.status == 'available'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'adoptedAt'])
        && request.resource.data.status == 'adopted'
        && request.resource.data.adoptedAt == request.time
        && getAfter(
          /databases/$(database)/documents/plushAdoptions/$(code)
        ).data.code == code;

      allow delete: if false;
    }

    match /plushAdoptions/{code} {
      allow get: if isVerifiedStaff() || isAdmin()
        || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow list: if isAdmin();

      allow create: if isVerifiedStaff()
        && request.resource.data.keys().hasOnly([
          'code', 'modelCode', 'serial', 'sequence', 'character', 'ownerUid',
          'ownerName', 'employeeUid', 'employeeEmail', 'adoptedAt', 'saleId'
        ])
        && request.resource.data.code == code
        && request.resource.data.employeeUid == request.auth.uid
        && request.resource.data.employeeEmail == request.auth.token.email
        && request.resource.data.adoptedAt == request.time
        && (
          !('saleId' in request.resource.data)
          || exists(
            /databases/$(database)/documents/cafeSales/$(request.resource.data.saleId)
          )
        )
        && (
          request.resource.data.ownerUid == null
          || exists(
            /databases/$(database)/documents/users/$(request.resource.data.ownerUid)
          )
        )
        && getAfter(
          /databases/$(database)/documents/collectiblePlushes/$(code)
        ).data.claimedBy == request.resource.data.ownerUid
        && getAfter(
          /databases/$(database)/documents/collectiblePlushes/$(code)
        ).data.claimedByName == request.resource.data.ownerName
        && getAfter(
          /databases/$(database)/documents/collectiblePlushes/$(code)
        ).data.claimedByEmployee == request.resource.data.employeeUid
        && getAfter(
          /databases/$(database)/documents/collectiblePlushes/$(code)
        ).data.modelCode == request.resource.data.modelCode
        && getAfter(
          /databases/$(database)/documents/collectiblePlushes/$(code)
        ).data.serial == request.resource.data.serial
        && getAfter(
          /databases/$(database)/documents/collectiblePlushes/$(code)
        ).data.sequence == request.resource.data.sequence
        && getAfter(
          /databases/$(database)/documents/collectiblePlushes/$(code)
        ).data.character == request.resource.data.character
        && getAfter(
          /databases/$(database)/documents/plushAuthenticity/$(code)
        ).data.status == 'adopted'
        && getAfter(
          /databases/$(database)/documents/plushAuthenticity/$(code)
        ).data.adoptedAt == request.resource.data.adoptedAt;

      allow update, delete: if false;
    }

    match /plushCertificates/{code} {
      allow get: if isVerifiedStaff() || isAdmin()
        || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow list: if isAdmin();

      allow create: if isVerifiedStaff()
        && request.resource.data.keys().hasOnly([
          'certificateNumber', 'code', 'modelCode', 'serial', 'sequence',
          'character', 'edition', 'version', 'ownerUid', 'ownerName',
          'adoptedAt', 'saleId'
        ])
        && request.resource.data.code == code
        && request.resource.data.certificateNumber == 'WOC-' + code
        && request.resource.data.edition == 'Original Collection'
        && request.resource.data.version == 1
        && request.resource.data.adoptedAt == request.time
        && (
          !('saleId' in request.resource.data)
          || request.resource.data.saleId
            == getAfter(
              /databases/$(database)/documents/plushAdoptions/$(code)
            ).data.saleId
        )
        && getAfter(
          /databases/$(database)/documents/plushAdoptions/$(code)
        ).data.code == code
        && getAfter(
          /databases/$(database)/documents/plushAdoptions/$(code)
        ).data.modelCode == request.resource.data.modelCode
        && getAfter(
          /databases/$(database)/documents/plushAdoptions/$(code)
        ).data.serial == request.resource.data.serial
        && getAfter(
          /databases/$(database)/documents/plushAdoptions/$(code)
        ).data.sequence == request.resource.data.sequence
        && getAfter(
          /databases/$(database)/documents/plushAdoptions/$(code)
        ).data.character == request.resource.data.character
        && getAfter(
          /databases/$(database)/documents/plushAdoptions/$(code)
        ).data.ownerUid == request.resource.data.ownerUid
        && getAfter(
          /databases/$(database)/documents/plushAdoptions/$(code)
        ).data.ownerName == request.resource.data.ownerName
        && getAfter(
          /databases/$(database)/documents/plushAdoptions/$(code)
        ).data.adoptedAt == request.resource.data.adoptedAt
        && (
          !('saleId' in request.resource.data)
          || getAfter(
            /databases/$(database)/documents/plushAdoptions/$(code)
          ).data.saleId == request.resource.data.saleId
        );

      allow update: if request.auth != null
          && resource.data.ownerUid is string
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['ownerUid', 'ownerName'])
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerName == null
          && get(
            /databases/$(database)/documents/collectiblePlushes/$(code)
          ).data.pendingTransferId is string
          && getAfter(
            /databases/$(database)/documents/plushOwnershipTransfers/$(get(/databases/$(database)/documents/collectiblePlushes/$(code)).data.pendingTransferId)
          ).data.collectibleCode == code
          && getAfter(
            /databases/$(database)/documents/plushOwnershipTransfers/$(get(/databases/$(database)/documents/collectiblePlushes/$(code)).data.pendingTransferId)
          ).data.fromUid == resource.data.ownerUid
          && getAfter(
            /databases/$(database)/documents/plushOwnershipTransfers/$(get(/databases/$(database)/documents/collectiblePlushes/$(code)).data.pendingTransferId)
          ).data.toUid == request.auth.uid
          && getAfter(
            /databases/$(database)/documents/plushOwnershipTransfers/$(get(/databases/$(database)/documents/collectiblePlushes/$(code)).data.pendingTransferId)
          ).data.status == 'accepted';

      allow delete: if false;
    }

    match /plushOwnershipTransfers/{transferId} {
      allow get, list: if request.auth != null
          && (
            resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid
            || isVerifiedStaff()
            || isAdmin()
          );

      allow create: if request.auth != null
          && request.auth.token.firebase.sign_in_provider != 'anonymous'
          && request.resource.data.keys().hasOnly([
            'collectibleCode', 'fromUid', 'toUid', 'status',
            'requestedAt', 'respondedAt', 'lastHistoryId'
          ])
          && request.resource.data.collectibleCode.matches(
            '^CW-(PLUSH-00[1-9]|CUP-00[7-9])-[0-9]{4}$'
          )
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.toUid is string
          && request.resource.data.toUid != request.auth.uid
          && exists(
            /databases/$(database)/documents/users/$(request.resource.data.toUid)
          )
          && request.resource.data.status == 'pending'
          && request.resource.data.requestedAt == request.time
          && request.resource.data.respondedAt == null
          && request.resource.data.lastHistoryId is string
          && existsAfter(
            /databases/$(database)/documents/plushOwnershipTransferHistory/$(request.resource.data.lastHistoryId)
          )
          && getAfter(
            /databases/$(database)/documents/plushOwnershipTransferHistory/$(request.resource.data.lastHistoryId)
          ).data.transferId == transferId
          && getAfter(
            /databases/$(database)/documents/plushOwnershipTransferHistory/$(request.resource.data.lastHistoryId)
          ).data.action == 'requested'
          && getAfter(
            /databases/$(database)/documents/collectiblePlushes/$(request.resource.data.collectibleCode)
          ).data.claimedBy == request.auth.uid
          && getAfter(
            /databases/$(database)/documents/collectiblePlushes/$(request.resource.data.collectibleCode)
          ).data.pendingTransferId == transferId
          && getAfter(
            /databases/$(database)/documents/plushAuthenticity/$(request.resource.data.collectibleCode)
          ).data.status == 'adopted'
          && getAfter(
            /databases/$(database)/documents/plushCertificates/$(request.resource.data.collectibleCode)
          ).data.ownerUid == request.auth.uid;

      allow update: if request.auth != null
          && request.auth.token.firebase.sign_in_provider != 'anonymous'
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'respondedAt', 'lastHistoryId'])
          && request.resource.data.respondedAt == request.time
          && request.resource.data.lastHistoryId is string
          && existsAfter(
            /databases/$(database)/documents/plushOwnershipTransferHistory/$(request.resource.data.lastHistoryId)
          )
          && getAfter(
            /databases/$(database)/documents/plushOwnershipTransferHistory/$(request.resource.data.lastHistoryId)
          ).data.transferId == transferId
          && getAfter(
            /databases/$(database)/documents/plushOwnershipTransferHistory/$(request.resource.data.lastHistoryId)
          ).data.actorUid == request.auth.uid
          && getAfter(
            /databases/$(database)/documents/plushOwnershipTransferHistory/$(request.resource.data.lastHistoryId)
          ).data.action == request.resource.data.status
          && (
            request.auth.uid == resource.data.toUid
              && request.resource.data.status in ['accepted', 'rejected']
              && getAfter(
                /databases/$(database)/documents/collectiblePlushes/$(resource.data.collectibleCode)
              ).data.code == resource.data.collectibleCode
              && !('pendingTransferId' in getAfter(
                /databases/$(database)/documents/collectiblePlushes/$(resource.data.collectibleCode)
              ).data)
              && (
                request.resource.data.status == 'accepted'
                  && getAfter(
                    /databases/$(database)/documents/collectiblePlushes/$(resource.data.collectibleCode)
                  ).data.claimedBy == request.auth.uid
                  && getAfter(
                    /databases/$(database)/documents/plushCertificates/$(resource.data.collectibleCode)
                  ).data.ownerUid == request.auth.uid
                || request.resource.data.status == 'rejected'
                  && getAfter(
                    /databases/$(database)/documents/collectiblePlushes/$(resource.data.collectibleCode)
                  ).data.claimedBy == resource.data.fromUid
              )
            || request.auth.uid == resource.data.fromUid
              && request.resource.data.status == 'cancelled'
              && getAfter(
                /databases/$(database)/documents/collectiblePlushes/$(resource.data.collectibleCode)
              ).data.claimedBy == resource.data.fromUid
              && getAfter(
                /databases/$(database)/documents/collectiblePlushes/$(resource.data.collectibleCode)
              ).data.code == resource.data.collectibleCode
              && !('pendingTransferId' in getAfter(
                /databases/$(database)/documents/collectiblePlushes/$(resource.data.collectibleCode)
              ).data)
          )
          && getAfter(
            /databases/$(database)/documents/collectiblePlushes/$(resource.data.collectibleCode)
          ).data.code == resource.data.collectibleCode;

      allow delete: if false;
    }

    match /plushOwnershipTransferHistory/{historyId} {
      allow get, list: if request.auth != null
          && (
            resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid
            || isVerifiedStaff()
            || isAdmin()
          );

      allow create: if request.auth != null
          && request.resource.data.keys().hasOnly([
            'transferId', 'collectibleCode', 'action', 'actorUid',
            'fromUid', 'toUid', 'createdAt'
          ])
          && request.resource.data.transferId is string
          && request.resource.data.collectibleCode.matches(
            '^CW-(PLUSH-00[1-9]|CUP-00[7-9])-[0-9]{4}$'
          )
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.fromUid is string
          && request.resource.data.toUid is string
          && request.resource.data.fromUid != request.resource.data.toUid
          && request.resource.data.createdAt == request.time
          && existsAfter(
            /databases/$(database)/documents/plushOwnershipTransfers/$(request.resource.data.transferId)
          )
          && getAfter(
            /databases/$(database)/documents/plushOwnershipTransfers/$(request.resource.data.transferId)
          ).data.collectibleCode == request.resource.data.collectibleCode
          && getAfter(
            /databases/$(database)/documents/plushOwnershipTransfers/$(request.resource.data.transferId)
          ).data.fromUid == request.resource.data.fromUid
          && getAfter(
            /databases/$(database)/documents/plushOwnershipTransfers/$(request.resource.data.transferId)
          ).data.toUid == request.resource.data.toUid
          && getAfter(
            /databases/$(database)/documents/plushOwnershipTransfers/$(request.resource.data.transferId)
          ).data.lastHistoryId == historyId
          && (
            request.resource.data.action == 'requested'
              && request.resource.data.actorUid == request.resource.data.fromUid
              && getAfter(
                /databases/$(database)/documents/plushOwnershipTransfers/$(request.resource.data.transferId)
              ).data.status == 'pending'
            || request.resource.data.action == 'accepted'
              && request.resource.data.actorUid == request.resource.data.toUid
              && getAfter(
                /databases/$(database)/documents/plushOwnershipTransfers/$(request.resource.data.transferId)
              ).data.status == 'accepted'
            || request.resource.data.action == 'rejected'
              && request.resource.data.actorUid == request.resource.data.toUid
              && getAfter(
                /databases/$(database)/documents/plushOwnershipTransfers/$(request.resource.data.transferId)
              ).data.status == 'rejected'
            || request.resource.data.action == 'cancelled'
              && request.resource.data.actorUid == request.resource.data.fromUid
              && getAfter(
                /databases/$(database)/documents/plushOwnershipTransfers/$(request.resource.data.transferId)
              ).data.status == 'cancelled'
          );

      allow update, delete: if false;
    }

    match /diamondBalances/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /wallets/{userId} {
      allow get: if request.auth != null
        && (
          request.auth.uid == userId
          || isAdmin()
        );
      allow list: if false;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'balance', 'updatedAt', 'lastTransactionId'
        ])
        && request.resource.data.ownerUid == userId
        && request.resource.data.balance is number
        && request.resource.data.balance >= 0
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastTransactionId is string
        && validGiftCardWalletCredit(
          userId,
          request.resource.data.lastTransactionId,
          getAfter(
            walletTransactionPath(request.resource.data.lastTransactionId)
          ).data.giftCardCode
        );

      allow update: if request.auth != null
        && resource.data.ownerUid == userId
        && request.resource.data.ownerUid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'balance', 'updatedAt', 'lastTransactionId'
        ])
        && request.resource.data.balance is number
        && request.resource.data.balance >= 0
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastTransactionId is string
        && (
          validGiftCardWalletCredit(
            userId,
            request.resource.data.lastTransactionId,
            getAfter(
              walletTransactionPath(request.resource.data.lastTransactionId)
            ).data.giftCardCode
          )
          || isVerifiedStaff()
            && validPosWalletDebit(
              userId,
              request.resource.data.lastTransactionId,
              request.resource.data.lastTransactionId
            )
        );

      allow delete: if false;
    }

    match /walletTransactions/{transactionId} {
      allow get: if request.auth != null
        && (
          isAdmin()
          || resource.data.ownerUid == request.auth.uid
        );
      allow list: if isAdmin()
        || (
          request.auth != null
          && resource.data.ownerUid == request.auth.uid
        );

      allow create: if request.resource.data.keys().hasOnly([
          'ownerUid', 'type', 'direction', 'amount', 'balanceBefore',
          'balanceAfter', 'giftCardCode', 'saleId', 'employeeUid', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'ownerUid', 'type', 'direction', 'amount', 'createdAt'
        ])
        && request.resource.data.ownerUid is string
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.createdAt == request.time
        && (
          request.resource.data.type == 'giftCardRedemption'
            && request.auth != null
            && request.auth.uid == request.resource.data.ownerUid
            && request.resource.data.direction == 'credit'
            && request.resource.data.giftCardCode is string
            && request.resource.data.balanceBefore is number
            && request.resource.data.balanceBefore >= 0
            && request.resource.data.balanceAfter is number
            && !('saleId' in request.resource.data)
            && !('employeeUid' in request.resource.data)
            && validGiftCardWalletCredit(
              request.resource.data.ownerUid,
              transactionId,
              request.resource.data.giftCardCode
            )
          || request.resource.data.type == 'posDebit'
            && isVerifiedStaff()
            && request.resource.data.direction == 'debit'
            && request.resource.data.saleId == transactionId
            && request.resource.data.employeeUid == request.auth.uid
            && !('balanceBefore' in request.resource.data)
            && !('balanceAfter' in request.resource.data)
            && !('giftCardCode' in request.resource.data)
            && validPosWalletDebit(
              request.resource.data.ownerUid,
              transactionId,
              request.resource.data.saleId
            )
        );

      allow update, delete: if false;
    }

    match /diamondLedger/{entryId} {
      allow read, write: if false;
    }

    match /plushUnitHistory/{historyId} {
      allow get, list: if isVerifiedStaff() || isAdmin();

      allow create: if isVerifiedStaff()
        && request.resource.data.keys().hasOnly([
          'code', 'modelCode', 'action', 'employeeUid',
          'employeeEmail', 'ownerUid', 'createdAt', 'saleId'
        ])
        && request.resource.data.code.matches(
          '^CW-(PLUSH-00[1-9]|CUP-00[7-9])-[0-9]{4}$'
        )
        && request.resource.data.action in ['registered', 'adopted']
        && request.resource.data.employeeUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && (
          request.resource.data.action == 'registered'
            && getAfter(
              /databases/$(database)/documents/collectiblePlushes/$(request.resource.data.code)
            ).data.createdBy == request.auth.uid
          || request.resource.data.action == 'adopted'
            && getAfter(
              /databases/$(database)/documents/plushAdoptions/$(request.resource.data.code)
            ).data.employeeUid == request.auth.uid
        );

      allow update, delete: if false;
    }

    match /giftCards/{code} {
      allow get: if isVerifiedStaff() || isAdmin()
        || (request.auth != null && resource.data.status == 'active');
      allow list: if isVerifiedStaff() || isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'code', 'initialBalance', 'balance', 'status', 'createdBy',
          'createdByEmail', 'createdAt', 'redeemedBy', 'redeemedAt',
          'lastRedemptionId',
        ])
        && request.resource.data.code == code
        && code.matches('^WOLF-[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}$')
        && request.resource.data.initialBalance is number
        && request.resource.data.initialBalance > 0
        && request.resource.data.balance == request.resource.data.initialBalance
        && request.resource.data.status == 'active'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByEmail == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.redeemedBy == null
        && request.resource.data.redeemedAt == null;

      allow update: if request.auth != null
        && resource.data.status == 'active'
        && request.resource.data.status == 'redeemed'
        && request.resource.data.balance == 0
        && request.resource.data.redeemedBy == request.auth.uid
        && request.resource.data.redeemedAt == request.time
        && request.resource.data.lastRedemptionId is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'balance', 'status', 'redeemedBy', 'redeemedAt',
          'lastRedemptionId'
        ])
        && validGiftCardWalletCredit(
          request.auth.uid,
          request.resource.data.lastRedemptionId,
          code
        );

      allow delete: if false;
    }

    match /rewardRedemptions/{redemptionId} {
      allow create: if isVerifiedStaff()
        && request.resource.data.keys().hasOnly([
          'customerUid', 'employeeUid', 'employeeEmail',
          'rewardType', 'rewardId', 'figureId', 'redeemedAt',
          'distanceMeters', 'status'
        ])
        && request.resource.data.keys().hasAll([
          'customerUid', 'employeeUid', 'employeeEmail',
          'rewardType', 'rewardId', 'redeemedAt'
        ])
        && request.resource.data.customerUid is string
        && request.resource.data.customerUid.size() > 0
        && exists(
          /databases/$(database)/documents/users/$(request.resource.data.customerUid)
        )
        && request.resource.data.employeeUid == request.auth.uid
        && request.resource.data.employeeEmail == request.auth.token.email
        && request.resource.data.rewardId is string
        && request.resource.data.rewardId.size() > 0
        && request.resource.data.redeemedAt == request.time
        && (
          request.resource.data.rewardType == 'coldBrewStamp'
            && redemptionId == request.resource.data.rewardId
            && request.resource.data.status == 'delivered'
            && request.resource.data.figureId in coldBrewFigureIds()
            && request.resource.data.distanceMeters is number
            && request.resource.data.distanceMeters >= 0
            && request.resource.data.distanceMeters <= 50
            && getAfter(
              /databases/$(database)/documents/coldBrewAlbums/$(request.resource.data.customerUid)
            ).data.lastRedemptionId == redemptionId
        );

      allow get, list: if isAdmin();
      allow update, delete: if false;
    }

    match /wolvesMatchParticipants/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if false;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && matchAccountEligible()
        && validMatchProfileFields(request.resource.data)
        && request.resource.data.status in ['configuring', 'active']
        && existsAfter(matchPublicIdAt(request.resource.data.matchPublicId))
        && getAfter(matchPublicIdAt(request.resource.data.matchPublicId)).data.uid
          == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && matchAccountEligible()
        && validMatchProfileFields(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.matchPublicId == resource.data.matchPublicId
        && matchProfileOwnedByCurrentUser(resource.data.matchPublicId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'bio', 'intention', 'interests', 'status',
          'consentAt', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /wolvesMatchPublicIds/{publicId} {
      allow get: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow list: if false;
      allow create: if matchAccountEligible()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && existsAfter(ownMatchParticipantPath())
        && getAfter(ownMatchParticipantPath()).data.matchPublicId == publicId;
      allow update, delete: if false;
    }

    match /wolvesMatchPublicProfiles/{publicId} {
      allow get: if matchAccountEligible()
        && (
          ownsMatchPublicId(publicId)
          ||
          resource.data.status == 'active'
          || exists(ownMatchParticipantPath())
            && matchPairExists(ownMatchPublicId(), publicId)
        );
      allow list: if matchAccountEligible()
        && resource.data.status == 'active';
      allow create, update: if matchAccountEligible()
        && validMatchPublicId(publicId)
        && request.resource.data.keys().hasOnly([
          'displayName', 'bio', 'intention', 'interests', 'status',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'displayName', 'bio', 'intention', 'interests', 'status',
          'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 180
        && !matchTextContainsPrivateContact(
          request.resource.data.displayName + '\n' + request.resource.data.bio
        )
        && validMatchIntention(request.resource.data.intention)
        && request.resource.data.interests is list
        && request.resource.data.interests.size() <= 5
        && request.resource.data.interests.toSet().hasOnly([
          'Café de especialidad', 'Eventos', 'Música', 'Lectura',
          'Naturaleza', 'Mascotas', 'Arte', 'Viajes',
          'Conversaciones', 'Deportes'
        ])
        && request.resource.data.status in [
          'configuring', 'active', 'paused', 'left'
        ]
        && request.resource.data.updatedAt == request.time
        && existsAfter(matchPublicIdAt(publicId))
        && getAfter(matchPublicIdAt(publicId)).data.uid == request.auth.uid
        && existsAfter(ownMatchParticipantPath())
        && getAfter(ownMatchParticipantPath()).data.matchPublicId == publicId
        && getAfter(ownMatchParticipantPath()).data.status
          == request.resource.data.status
        && getAfter(ownMatchParticipantPath()).data.displayName
          == request.resource.data.displayName
        && getAfter(ownMatchParticipantPath()).data.bio
          == request.resource.data.bio
        && getAfter(ownMatchParticipantPath()).data.intention
          == request.resource.data.intention
        && getAfter(ownMatchParticipantPath()).data.interests
          == request.resource.data.interests;
      allow delete: if false;
    }

    match /wolvesMatchPairs/{pairId} {
      allow get: if exists(
          /databases/$(database)/documents/wolvesMatchPairs/$(pairId)
        )
          && readableMatchPair(resource.data)
        || canGetMissingMatchPair(pairId);
      allow list: if false;
      allow create: if canCreateMatchPair(request.resource.data, pairId);
      allow update: if canUpdateMatchPair(request.resource.data, pairId);
      allow delete: if false;
    }

    match /wolvesMatchUsers/{publicId}/pairs/{pairId} {
      function pairPath() {
        return /databases/$(database)/documents/wolvesMatchPairs/$(pairId);
      }

      function validPairView(data, sourcePair) {
        return sourcePair.publicIds is list
          && sourcePair.publicIds.size() == 2
          && publicId in sourcePair.publicIds
          && data.keys().hasOnly([
            'peerPublicId', 'status', 'interestFromPublicId', 'updatedAt'
          ])
          && data.keys().hasAll([
            'peerPublicId', 'status', 'interestFromPublicId', 'updatedAt'
          ])
          && validMatchPublicId(data.peerPublicId)
          && data.peerPublicId != publicId
          && data.peerPublicId in sourcePair.publicIds
          && data.status == sourcePair.status
          && data.interestFromPublicId == sourcePair.interestFromPublicId
          && data.updatedAt == request.time
          && sourcePair.decidedByPublicId == ownMatchPublicId()
          && sourcePair.updatedAt == request.time;
      }

      allow get, list: if ownsMatchPublicId(publicId);
      allow create, update: if matchAccountEligible()
        && exists(ownMatchParticipantPath())
        && get(ownMatchParticipantPath()).data.status == 'active'
        && existsAfter(pairPath())
        && ownMatchPublicId()
          in getAfter(pairPath()).data.publicIds
        && validPairView(
          request.resource.data,
          getAfter(pairPath()).data
        );
      allow delete: if false;
    }

    match /wolvesMatchBlocks/{userId}/users/{blockedUserId} {
      allow get: if matchAccountEligible()
        && (
          ownsMatchPublicId(userId)
          || ownsMatchPublicId(blockedUserId)
        );
      allow list: if false;
      allow create: if ownsMatchPublicId(userId)
        && matchAccountEligible()
        && validMatchPublicId(blockedUserId)
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /wolvesMatchReports/{reportId} {
      allow create: if matchAccountEligible()
        && request.resource.data.keys().hasOnly([
          'reporterUid', 'targetPublicId', 'reason', 'details',
          'status', 'createdAt'
        ])
        && request.resource.data.reporterUid == request.auth.uid
        && validMatchPublicId(request.resource.data.targetPublicId)
        && activeMatchProfile(request.resource.data.targetPublicId)
        && request.resource.data.reason in [
          'inappropriate', 'fake', 'harassment', 'other'
        ]
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 500
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow get, list: if isAdmin();
      allow update, delete: if false;
    }

    match /wolvesMatchIcebreakers/{pairId}/answers/{answerId} {
      function icebreakerPairPath() {
        return /databases/$(database)/documents/wolvesMatchPairs/$(pairId);
      }

      function icebreakerPairIsActive() {
        return matchAccountEligible()
          && exists(ownMatchParticipantPath())
          && get(ownMatchParticipantPath()).data.status == 'active'
          && exists(icebreakerPairPath())
          && get(icebreakerPairPath()).data.status == 'mutual'
          && get(icebreakerPairPath()).data.publicIds is list
          && get(icebreakerPairPath()).data.publicIds.size() == 2
          && pairId == get(icebreakerPairPath()).data.publicIds[0]
            + '__' + get(icebreakerPairPath()).data.publicIds[1]
          && ownMatchPublicId() in get(icebreakerPairPath()).data.publicIds
          && compatibleActiveMatchPair(
            get(icebreakerPairPath()).data.publicIds[0],
            get(icebreakerPairPath()).data.publicIds[1]
          );
      }

      function validIcebreakerAnswer(data) {
        return data.keys().hasOnly([
            'questionId', 'publicId', 'answerIndex', 'createdAt'
          ])
          && data.keys().hasAll([
            'questionId', 'publicId', 'answerIndex', 'createdAt'
          ])
          && data.questionId.matches('^q[0-4]$')
          && data.publicId in get(icebreakerPairPath()).data.publicIds
          && data.answerIndex is int
          && data.answerIndex >= 0
          && data.answerIndex <= 3
          && data.createdAt is timestamp;
      }

      function canReadIcebreakerAnswer() {
        let ownAnswerId =
          resource.data.questionId + '__' + ownMatchPublicId();
        return icebreakerPairIsActive()
          && validIcebreakerAnswer(resource.data)
          && answerId
            == resource.data.questionId + '__' + resource.data.publicId
          && (
            resource.data.publicId == ownMatchPublicId()
            || (
              exists(
                /databases/$(database)/documents/wolvesMatchIcebreakers/$(pairId)/answers/$(ownAnswerId)
              )
              && exists(
                /databases/$(database)/documents/wolvesMatchIcebreakers/$(pairId)/answers/$(answerId)
              )
            )
          );
      }

      function isOwnIcebreakerAnswerId() {
        return answerId in [
          'q0__' + ownMatchPublicId(),
          'q1__' + ownMatchPublicId(),
          'q2__' + ownMatchPublicId(),
          'q3__' + ownMatchPublicId(),
          'q4__' + ownMatchPublicId()
        ];
      }

      allow get: if icebreakerPairIsActive()
          && (
            !exists(
              /databases/$(database)/documents/wolvesMatchIcebreakers/$(pairId)/answers/$(answerId)
            )
            && isOwnIcebreakerAnswerId()
            || canReadIcebreakerAnswer()
          );
      allow list: if false;
      allow create: if icebreakerPairIsActive()
          && validIcebreakerAnswer(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.publicId == ownMatchPublicId()
        && answerId
          == request.resource.data.questionId + '__' + ownMatchPublicId();
      allow update, delete: if false;
    }

    match /game_sessions/{sessionId} {
      allow get: if request.auth != null
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants;
      allow list, create, update, delete: if false;

      match /privateAnswers/{userId} {
        allow get: if request.auth != null
          && request.auth.uid == userId
          && exists(
            /databases/$(database)/documents/game_sessions/$(sessionId)
          )
          && request.auth.uid in get(
            /databases/$(database)/documents/game_sessions/$(sessionId)
          ).data.participants;
        allow list, create, update, delete: if false;
      }
    }
  }
}

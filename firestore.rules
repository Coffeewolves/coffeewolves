rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isManagementRole(role) {
      return role is string
        && role.lower() in [
          'admin', 'gerente', 'gerencia', 'manager', 'management',
          'administrator'
        ];
    }

    function isStaffRole(role) {
      return role is string && role.lower() in ['barista', 'cajero'];
    }

    function databaseRole() {
      let managementPath =
        /databases/$(database)/documents/management/$(request.auth.uid);
      let staffPath =
        /databases/$(database)/documents/pos_staff/$(request.auth.uid);
      let userPath =
        /databases/$(database)/documents/users/$(request.auth.uid);
      let managementRole = exists(managementPath)
        ? get(managementPath).data.get(
            'role',
            get(managementPath).data.get('rol', '')
          )
        : '';
      let staffRole = exists(staffPath)
        ? get(staffPath).data.get(
            'role',
            get(staffPath).data.get('rol', '')
          )
        : '';
      return exists(managementPath)
        && isManagementRole(managementRole)
        ? get(managementPath).data.get(
            'role',
            get(managementPath).data.get('rol', '')
          )
        : exists(staffPath)
          && isStaffRole(staffRole)
          ? get(staffPath).data.get(
              'role',
              get(staffPath).data.get('rol', '')
            )
          : exists(userPath)
            ? get(userPath).data.get(
              'role',
              get(userPath).data.get('rol', '')
              )
            : '';
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && isManagementRole(databaseRole());
    }

    function validPackLegacyProfile(data) {
      return data.keys().hasOnly([
          'memberName', 'petName', 'petBreed', 'story', 'achievements',
          'experienceTitle', 'experienceDescription', 'photoUrl',
          'published', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'memberName', 'petName', 'petBreed', 'story', 'achievements',
          'experienceTitle', 'experienceDescription', 'photoUrl',
          'published', 'createdAt', 'updatedAt'
        ])
        && data.memberName is string
        && data.memberName.size() > 0
        && data.memberName.size() <= 80
        && data.petName is string
        && data.petName.size() > 0
        && data.petName.size() <= 80
        && data.petBreed is string
        && data.petBreed.size() > 0
        && data.petBreed.size() <= 80
        && data.story is string
        && data.story.size() > 0
        && data.story.size() <= 3000
        && data.achievements is list
        && data.achievements.size() <= 12
        && data.experienceTitle is string
        && data.experienceTitle.size() <= 120
        && data.experienceDescription is string
        && data.experienceDescription.size() <= 1200
        && data.photoUrl is string
        && data.photoUrl.size() <= 1000
        && (
          data.photoUrl.size() == 0
          || data.photoUrl.matches('^https://.*$')
        )
        && data.published is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isVerifiedStaff() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (
          isStaffRole(databaseRole())
          || isManagementRole(databaseRole())
        );
    }

    function walletPath(userId) {
      return /databases/$(database)/documents/wallets/$(userId);
    }

    function walletTransactionPath(transactionId) {
      return /databases/$(database)/documents/walletTransactions/$(transactionId);
    }

    function walletBalanceBefore(userId) {
      return exists(walletPath(userId))
        ? get(walletPath(userId)).data.balance
        : 0;
    }

    function validGiftCardWalletCredit(userId, transactionId, giftCardCode) {
      let transactionPath = walletTransactionPath(transactionId);
      let giftCardPath =
        /databases/$(database)/documents/giftCards/$(giftCardCode);
      let walletAfterPath = walletPath(userId);
      let entry = getAfter(transactionPath).data;
      let card = getAfter(giftCardPath).data;
      let wallet = getAfter(walletAfterPath).data;
      return existsAfter(transactionPath)
        && existsAfter(giftCardPath)
        && existsAfter(walletAfterPath)
        && get(giftCardPath).data.status == 'active'
        && entry.ownerUid == userId
        && entry.type == 'giftCardRedemption'
        && entry.direction == 'credit'
        && entry.giftCardCode == giftCardCode
        && entry.amount == get(giftCardPath).data.balance
        && entry.amount == get(giftCardPath).data.initialBalance
        && entry.amount > 0
        && entry.balanceBefore == walletBalanceBefore(userId)
        && entry.balanceAfter == entry.balanceBefore + entry.amount
        && entry.createdAt == request.time
        && card.status == 'redeemed'
        && card.balance == 0
        && card.redeemedBy == userId
        && card.redeemedAt == request.time
        && card.lastRedemptionId == transactionId
        && wallet.ownerUid == userId
        && wallet.balance == entry.balanceAfter
        && wallet.lastTransactionId == transactionId
        && wallet.updatedAt == request.time;
    }

    function validPosWalletDebit(userId, transactionId, saleId) {
      let transactionPath = walletTransactionPath(transactionId);
      let salePath = /databases/$(database)/documents/cafeSales/$(saleId);
      let walletAfterPath = walletPath(userId);
      let entry = getAfter(transactionPath).data;
      let sale = getAfter(salePath).data;
      let wallet = getAfter(walletAfterPath).data;
      let walletBefore = get(walletPath(userId)).data;
      return existsAfter(transactionPath)
        && existsAfter(salePath)
        && existsAfter(walletAfterPath)
        && exists(walletPath(userId))
        && walletBefore.ownerUid == userId
        && walletBefore.balance is number
        && walletBefore.balance >= entry.amount
        && entry.ownerUid == userId
        && entry.type == 'posDebit'
        && entry.direction == 'debit'
        && entry.saleId == saleId
        && entry.employeeUid == request.auth.uid
        && entry.amount is number
        && entry.amount > 0
        && entry.createdAt == request.time
        && sale.paymentMethod == 'wallet'
        && sale.walletTransactionId == transactionId
        && sale.customerUid == userId
        && sale.total == entry.amount
        && sale.employeeUid == request.auth.uid
        && wallet.ownerUid == userId
        && wallet.balance == walletBefore.balance - entry.amount
        && wallet.balance >= 0
        && wallet.lastTransactionId == transactionId
        && wallet.updatedAt == request.time;
    }

    function validShopSizeStock(data) {
      return !('stockBySize' in data)
        || data.stockBySize is map
          && data.stockBySize.keys().hasOnly([
            'S', 'M', 'L', 'XL', '2XL', '3XL'
          ])
          && data.stockBySize.get('S', 0) is int
          && data.stockBySize.get('S', 0) >= 0
          && data.stockBySize.get('M', 0) is int
          && data.stockBySize.get('M', 0) >= 0
          && data.stockBySize.get('L', 0) is int
          && data.stockBySize.get('L', 0) >= 0
          && data.stockBySize.get('XL', 0) is int
          && data.stockBySize.get('XL', 0) >= 0
          && data.stockBySize.get('2XL', 0) is int
          && data.stockBySize.get('2XL', 0) >= 0
          && data.stockBySize.get('3XL', 0) is int
          && data.stockBySize.get('3XL', 0) >= 0
          && data.stock
            == data.stockBySize.get('S', 0)
              + data.stockBySize.get('M', 0)
              + data.stockBySize.get('L', 0)
              + data.stockBySize.get('XL', 0)
              + data.stockBySize.get('2XL', 0)
              + data.stockBySize.get('3XL', 0);
    }

    function auditMatches(auditId, customerUid, rewardType, rewardId) {
      let audit = getAfter(
        /databases/$(database)/documents/rewardRedemptions/$(auditId)
      ).data;
      return audit.customerUid == customerUid
        && audit.employeeUid == request.auth.uid
        && audit.rewardType == rewardType
        && audit.rewardId == rewardId
        && audit.redeemedAt == request.time;
    }

    function coldBrewFigureIds() {
      return [
        'classic', 'orange', 'nitro', 'wolves_milk', 'orange_milk',
        'berry_milk', 'pineapple_milk', 'coconut_milk',
        'passion_fruit_milk', 'peach_milk', 'vanilla_milk', 'copoazu_milk',
        'lemon_milk', 'blackberry_milk', 'apple_milk', 'lulo_milk'
      ];
    }

    function validColdBrewFigureList(figures) {
      return figures is list
        && figures.toSet().size() == figures.size()
        && figures.toSet().hasOnly(coldBrewFigureIds());
    }

    function validPassportMethod(methodName) {
      return methodName in [
        'Dripper V60', 'Chemex', 'Origami', 'Aeropress',
        'Prensa francesa', 'Sifón japonés', 'Sifón belga',
        'Cold Brew', 'Nitro Cold Brew'
      ];
    }

    function completePassport(methods) {
      return methods is list
        && methods.size() == 9
        && methods.hasAll([
          'Dripper V60', 'Chemex', 'Origami', 'Aeropress',
          'Prensa francesa', 'Sifón japonés', 'Sifón belga',
          'Cold Brew', 'Nitro Cold Brew'
        ]);
    }

    function passportStampMatches(stampId, customerUid, methodName) {
      let stamp = getAfter(
        /databases/$(database)/documents/passportMethodStamps/$(stampId)
      ).data;
      return stamp.customerUid == customerUid
        && stamp.employeeUid == request.auth.uid
        && stamp.methodName == methodName
        && stamp.stampedAt == request.time;
    }

    function memberCardLookupMatches(userId, sequence) {
      let memberCard = getAfter(
        /databases/$(database)/documents/memberCards/$(userId)
      ).data;
      let lookup = getAfter(
        /databases/$(database)/documents/memberCardLookups/$(memberCard.cardNumber)
      ).data;
      return memberCard.sequence == sequence
        && lookup.userUid == userId
        && lookup.cardNumber == memberCard.cardNumber
        && lookup.sequence == sequence;
    }

    function hasActiveMemberCard(userId) {
      let cardPath =
        /databases/$(database)/documents/memberCards/$(userId);
      return exists(cardPath)
        && get(cardPath).data.userUid == userId
        && get(cardPath).data.cardNumber is string
        && get(cardPath).data.cardNumber.matches('^CW-[0-9]{6}$')
        && exists(
          /databases/$(database)/documents/memberCardLookups/$(get(cardPath).data.cardNumber)
        )
        && get(
          /databases/$(database)/documents/memberCardLookups/$(get(cardPath).data.cardNumber)
        ).data.userUid == userId
        && get(
          /databases/$(database)/documents/memberCardLookups/$(get(cardPath).data.cardNumber)
        ).data.cardNumber == get(cardPath).data.cardNumber
        && get(
          /databases/$(database)/documents/memberCardLookups/$(get(cardPath).data.cardNumber)
        ).data.sequence == get(cardPath).data.sequence;
    }

    function memberCardHolderMatches(holderId, cardNumber, sequence, createdBy) {
      return (
        existsAfter(
          /databases/$(database)/documents/customers/$(holderId)
        )
        && getAfter(
          /databases/$(database)/documents/customers/$(holderId)
        ).data.memberCardNumber == cardNumber
        && getAfter(
          /databases/$(database)/documents/customers/$(holderId)
        ).data.sequence == sequence
        && getAfter(
          /databases/$(database)/documents/customers/$(holderId)
        ).data.createdBy == createdBy
      ) || (
        existsAfter(
          /databases/$(database)/documents/member_cards/$(holderId)
        )
        && getAfter(
          /databases/$(database)/documents/member_cards/$(holderId)
        ).data.memberCardNumber == cardNumber
        && getAfter(
          /databases/$(database)/documents/member_cards/$(holderId)
        ).data.sequence == sequence
        && getAfter(
          /databases/$(database)/documents/member_cards/$(holderId)
        ).data.createdBy == createdBy
      );
    }

    function memberCardHolderLookupMatches(cardNumber, sequence) {
      let lookup = getAfter(
        /databases/$(database)/documents/customerMemberCardLookups/$(cardNumber)
      ).data;
      let holderId = lookup.get('holderId', lookup.get('customerId', ''));
      return lookup.cardNumber == cardNumber
        && lookup.sequence == sequence
        && lookup.createdBy == request.auth.uid
        && memberCardHolderMatches(
          holderId,
          cardNumber,
          sequence,
          request.auth.uid
        );
    }

    function validCollectibleModel(modelCode, character) {
      return (modelCode == 'CW-PLUSH-001' && character == 'El Alfa')
        || (modelCode == 'CW-PLUSH-002' && character == 'El Explorador')
        || (modelCode == 'CW-PLUSH-003' && character == 'El Elegante')
        || (modelCode == 'CW-PLUSH-004' && character == 'El Nómada')
        || (modelCode == 'CW-PLUSH-005' && character == 'El Aventurero')
        || (modelCode == 'CW-PLUSH-006' && character == 'El Protector')
        // Preserve records created with the earlier PLUSH model codes.
        || (modelCode == 'CW-PLUSH-007' && character == 'POMI')
        || (modelCode == 'CW-PLUSH-008' && character == 'SAMO')
        || (modelCode == 'CW-PLUSH-009' && character == 'HUSKY')
        || (modelCode == 'CW-CUP-007' && character == 'POMERANIAN')
        || (modelCode == 'CW-CUP-008' && character == 'SAMOYED')
        || (modelCode == 'CW-CUP-009' && character == 'HUSKY');
    }

    function usernameProfileMatches(userId, username, role) {
      return (
        role == 'user'
        && existsAfter(
          /databases/$(database)/documents/users/$(userId)
        )
        && getAfter(
          /databases/$(database)/documents/users/$(userId)
        ).data.get('username', '').lower() == username
      ) || (
        role == 'staff'
        && existsAfter(
          /databases/$(database)/documents/staffAccessRequests/$(userId)
        )
        && getAfter(
          /databases/$(database)/documents/staffAccessRequests/$(userId)
        ).data.get('username', '').lower() == username
      ) || (
        role == 'management'
        && isAdmin()
        && existsAfter(
          /databases/$(database)/documents/management/$(userId)
        )
        && getAfter(
          /databases/$(database)/documents/management/$(userId)
        ).data.get('username', '').lower() == username
      );
    }

    function validUsernameReservation(data, username) {
      return data.keys().hasOnly(['uid', 'username', 'role'])
        && data.keys().hasAll(['uid', 'username', 'role'])
        && data.uid == request.auth.uid
        && data.username == username
        && username.matches('^[a-z0-9._-]{3,20}$')
        && data.role in ['user', 'staff', 'management']
        && usernameProfileMatches(data.uid, username, data.role);
    }

    function adultMatchBirthDate(birthDate) {
      let birthDateParts = birthDate.split('-');
      return birthDate is string
        && birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && int(birthDateParts[0]) <= request.time.year() - 18
        && (
          int(birthDateParts[0]) < request.time.year() - 18
          || int(birthDateParts[1]) < request.time.month()
          || (
            int(birthDateParts[1]) == request.time.month()
            && int(birthDateParts[2]) <= request.time.day()
          )
        )
        && int(birthDateParts[1]) >= 1
        && int(birthDateParts[1]) <= 12
        && int(birthDateParts[2]) >= 1
        && int(birthDateParts[2]) <= 31;
    }

    function matchAccountEligible() {
      let profilePath =
        /databases/$(database)/documents/users/$(request.auth.uid);
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(profilePath)
        && adultMatchBirthDate(
          get(profilePath).data.get(
            'birthDate',
            get(profilePath).data.get('dateOfBirth', '')
          )
        );
    }

    function validMatchPublicId(publicId) {
      return publicId is string
        && publicId.matches('^[A-Za-z0-9_-]{8,80}$');
    }

    function validMatchIntention(intention) {
      return intention in ['friendship', 'romantic', 'both'];
    }

    function matchIntentionsCompatible(intentionA, intentionB) {
      return validMatchIntention(intentionA)
        && validMatchIntention(intentionB)
        && (
          intentionA == 'both'
          || intentionB == 'both'
          || intentionA == intentionB
        );
    }

    function validMatchProfileFields(data) {
      return data.keys().hasOnly([
          'displayName', 'bio', 'intention', 'interests', 'status',
          'matchPublicId', 'consentAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'displayName', 'bio', 'intention', 'interests', 'status',
          'matchPublicId', 'consentAt', 'createdAt', 'updatedAt'
        ])
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 40
        && data.bio is string
        && data.bio.size() <= 180
        && !matchTextContainsPrivateContact(data.displayName + '\n' + data.bio)
        && validMatchIntention(data.intention)
        && data.interests is list
        && data.interests.size() <= 5
        && data.interests.toSet().size() == data.interests.size()
        && data.interests.toSet().hasOnly([
          'Café de especialidad', 'Eventos', 'Música', 'Lectura',
          'Naturaleza', 'Mascotas', 'Arte', 'Viajes',
          'Conversaciones', 'Deportes'
        ])
        && data.status in ['configuring', 'active', 'paused', 'left']
        && validMatchPublicId(data.matchPublicId)
        && data.createdAt is timestamp
        && data.updatedAt == request.time
        && (
          data.status != 'active'
          || data.consentAt == request.time
        );
    }

    function matchTextContainsPrivateContact(text) {
      return text.matches(
          '(?s).*[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+[.][A-Za-z]{2,}.*'
        )
        || text.matches('(?s).*\\+?[0-9][0-9\\s().-]{8,}[0-9].*')
        || text.matches(
          '(?i).*-?[0-9]{1,3}[.][0-9]{3,}\\s*[,;]\\s*-?[0-9]{1,3}[.][0-9]{3,}.*'
        )
        || text.matches(
          '(?i).*(calle|av(enida)?|pasaje|carretera|street|avenue)\\s+([a-z]+\\s+)?[0-9]+.*'
        );
    }

    function ownMatchParticipantPath() {
      return /databases/$(database)/documents/wolvesMatchParticipants/$(request.auth.uid);
    }

    function ownMatchPublicId() {
      return get(ownMatchParticipantPath()).data.matchPublicId;
    }

    function ownsMatchPublicId(publicId) {
      return matchAccountEligible()
        && exists(ownMatchParticipantPath())
        && get(ownMatchParticipantPath()).data.matchPublicId == publicId;
    }

    function matchProfileAt(publicId) {
      return /databases/$(database)/documents/wolvesMatchPublicProfiles/$(publicId);
    }

    function matchPublicIdAt(publicId) {
      return /databases/$(database)/documents/wolvesMatchPublicIds/$(publicId);
    }

    function matchProfileOwnedByCurrentUser(publicId) {
      return exists(matchPublicIdAt(publicId))
        && get(matchPublicIdAt(publicId)).data.uid == request.auth.uid;
    }

    function activeMatchProfile(publicId) {
      return validMatchPublicId(publicId)
        && exists(matchProfileAt(publicId))
        && get(matchProfileAt(publicId)).data.status == 'active';
    }

    function matchPairAt(publicIdA, publicIdB) {
      return /databases/$(database)/documents/wolvesMatchPairs/$(publicIdA + '__' + publicIdB);
    }

    function matchPairExists(publicIdA, publicIdB) {
      return exists(matchPairAt(publicIdA, publicIdB))
        || exists(matchPairAt(publicIdB, publicIdA));
    }

    function readableMatchPair(data) {
      return matchAccountEligible()
        && exists(ownMatchParticipantPath())
        && data.publicIds is list
        && ownMatchPublicId() in data.publicIds;
    }

    function canGetMissingMatchPair(pairId) {
      let ownId = get(ownMatchParticipantPath()).data.matchPublicId;
      let pairPath =
        /databases/$(database)/documents/wolvesMatchPairs/$(pairId);
      return matchAccountEligible()
        && exists(ownMatchParticipantPath())
        && get(ownMatchParticipantPath()).data.status == 'active'
        && !exists(pairPath)
        && (
          pairId.matches(
            '^' + ownId + '__[A-Za-z0-9_-]{8,80}$'
          )
          || pairId.matches(
            '^[A-Za-z0-9_-]{8,80}__' + ownId + '$'
          )
        );
    }

    function compatibleActiveMatchPair(publicIdA, publicIdB) {
      return activeMatchProfile(publicIdA)
        && activeMatchProfile(publicIdB)
        && matchIntentionsCompatible(
          get(matchProfileAt(publicIdA)).data.intention,
          get(matchProfileAt(publicIdB)).data.intention
        )
        && !exists(
          /databases/$(database)/documents/wolvesMatchBlocks/$(publicIdA)/users/$(publicIdB)
        )
        && !exists(
          /databases/$(database)/documents/wolvesMatchBlocks/$(publicIdB)/users/$(publicIdA)
        );
    }

    function validMatchPairData(data, pairId) {
      return data.keys().hasOnly([
          'publicIds', 'status', 'interestFromPublicId',
          'decidedByPublicId', 'createdAt', 'updatedAt',
          'mutualAt', 'decidedAt'
        ])
        && data.keys().hasAll([
          'publicIds', 'status', 'interestFromPublicId',
          'createdAt', 'updatedAt'
        ])
        && data.publicIds is list
        && data.publicIds.size() == 2
        && validMatchPublicId(data.publicIds[0])
        && validMatchPublicId(data.publicIds[1])
        && data.publicIds[0] != data.publicIds[1]
        && pairId == data.publicIds[0] + '__' + data.publicIds[1]
        && data.status in ['pending', 'mutual', 'declined', 'blocked']
        && validMatchPublicId(data.interestFromPublicId)
        && data.interestFromPublicId in data.publicIds
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function canCreateMatchPair(data, pairId) {
      let actorId = ownMatchPublicId();
      let isInterest = data.status == 'pending'
        && data.interestFromPublicId == actorId
        && compatibleActiveMatchPair(data.publicIds[0], data.publicIds[1]);
      let isDismissal = data.status == 'declined'
        && data.interestFromPublicId == actorId
        && data.decidedByPublicId == actorId
        && data.decidedAt == request.time
        && compatibleActiveMatchPair(data.publicIds[0], data.publicIds[1]);
      let targetId =
        data.publicIds[0] == actorId ? data.publicIds[1] : data.publicIds[0];
      let isBlock = data.status == 'blocked'
        && data.interestFromPublicId == actorId
        && existsAfter(
          /databases/$(database)/documents/wolvesMatchBlocks/$(actorId)/users/$(targetId)
        );
      return matchAccountEligible()
        && exists(ownMatchParticipantPath())
        && get(ownMatchParticipantPath()).data.status == 'active'
        && validMatchPairData(data, pairId)
        && actorId in data.publicIds
        && activeMatchProfile(targetId)
        && (isInterest || isDismissal || isBlock)
        && data.createdAt == request.time;
    }

    function canUpdateMatchPair(data, pairId) {
      let actorId = ownMatchPublicId();
      let wasPending = resource.data.status == 'pending';
      let isRecipient = wasPending
        && resource.data.interestFromPublicId != actorId;
      let isDismissal = data.status == 'declined'
        && data.interestFromPublicId == actorId
        && data.decidedByPublicId == actorId
        && data.decidedAt == request.time
        && resource.data.status in ['pending', 'declined'];
      let isResponse = isRecipient
        && data.decidedByPublicId == actorId
        && data.status in ['mutual', 'declined']
        && (
          data.status == 'mutual'
          && data.mutualAt == request.time
          || data.status == 'declined'
          && data.decidedAt == request.time
        );
      let isBlock = data.status == 'blocked'
        && data.interestFromPublicId == actorId
        && existsAfter(
          /databases/$(database)/documents/wolvesMatchBlocks/$(actorId)/users/$(data.publicIds[0] == actorId ? data.publicIds[1] : data.publicIds[0])
        );
      return matchAccountEligible()
        && get(ownMatchParticipantPath()).data.status == 'active'
        && readableMatchPair(resource.data)
        && validMatchPairData(data, pairId)
        && data.publicIds == resource.data.publicIds
        && data.createdAt == resource.data.createdAt
        && (
          isDismissal
          && compatibleActiveMatchPair(data.publicIds[0], data.publicIds[1])
          || isResponse
          && compatibleActiveMatchPair(data.publicIds[0], data.publicIds[1])
          || isBlock
        );
    }

    match /usernameRegistry/{username} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && validUsernameReservation(request.resource.data, username);
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && validUsernameReservation(request.resource.data, username);
      allow delete: if request.auth != null
        && (
          resource.data.uid == request.auth.uid
          && (
          resource.data.role == 'user'
          && (
            !existsAfter(
              /databases/$(database)/documents/users/$(request.auth.uid)
            )
            || getAfter(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.get('username', '').lower() != username
          )
          || resource.data.role == 'staff'
          && (
            !existsAfter(
              /databases/$(database)/documents/staffAccessRequests/$(request.auth.uid)
            )
            || getAfter(
              /databases/$(database)/documents/staffAccessRequests/$(request.auth.uid)
            ).data.get('username', '').lower() != username
          )
          || resource.data.role == 'management'
          && (
            !existsAfter(
              /databases/$(database)/documents/management/$(request.auth.uid)
            )
            || getAfter(
              /databases/$(database)/documents/management/$(request.auth.uid)
            ).data.get('username', '').lower() != username
          )
          )
          || isAdmin()
          && resource.data.role == 'staff'
          && !existsAfter(
            /databases/$(database)/documents/staffAccessRequests/$(resource.data.uid)
          )
        );
    }

    match /management/{userId} {
      allow get: if request.auth != null
        && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, delete: if false;
      allow update: if isAdmin()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['username'])
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-zA-Z0-9._-]{3,20}$')
        && existsAfter(
          /databases/$(database)/documents/usernameRegistry/$(request.resource.data.username.lower())
        )
        && getAfter(
          /databases/$(database)/documents/usernameRegistry/$(request.resource.data.username.lower())
        ).data.uid == userId
        && getAfter(
          /databases/$(database)/documents/usernameRegistry/$(request.resource.data.username.lower())
        ).data.role == 'management';
    }

    match /pos_staff/{userId} {
      allow get: if request.auth != null
        && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'email', 'displayName', 'username', 'birthDate', 'role', 'createdAt',
          'approvedAt'
        ])
        && request.resource.data.keys().hasAll([
          'email', 'displayName', 'birthDate', 'role', 'createdAt',
          'approvedAt'
        ])
        && request.resource.data.role in ['barista', 'cajero']
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && (
          !('username' in request.resource.data)
          || request.resource.data.username is string
            && request.resource.data.username.matches(
              '^[a-zA-Z0-9._-]{3,20}$'
            )
            && existsAfter(
              /databases/$(database)/documents/staffAccessRequests/$(userId)
            )
            && getAfter(
              /databases/$(database)/documents/staffAccessRequests/$(userId)
            ).data.get('username', '').lower()
              == request.resource.data.username.lower()
        )
        && request.resource.data.birthDate is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.approvedAt == request.time;

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'email', 'displayName', 'username', 'birthDate', 'role', 'approvedAt'
          ])
        && request.resource.data.role in ['barista', 'cajero']
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && (
          !('username' in request.resource.data)
          || request.resource.data.username is string
            && request.resource.data.username.matches(
              '^[a-zA-Z0-9._-]{3,20}$'
            )
            && existsAfter(
              /databases/$(database)/documents/staffAccessRequests/$(userId)
            )
            && getAfter(
              /databases/$(database)/documents/staffAccessRequests/$(userId)
            ).data.get('username', '').lower()
              == request.resource.data.username.lower()
        )
        && request.resource.data.birthDate is string
        && request.resource.data.approvedAt == request.time;

      allow delete: if false;
    }

    match /mischiefPosts/{postId} {
      allow get, list: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';

      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'ownerName', 'dogName', 'description',
          'photoPath', 'photoUrl', 'innocentVotes', 'guiltyVotes',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'ownerUid', 'ownerName', 'dogName', 'description',
          'photoPath', 'photoUrl', 'innocentVotes', 'guiltyVotes',
          'createdAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() >= 1
        && request.resource.data.ownerName.size() <= 80
        && request.resource.data.dogName is string
        && request.resource.data.dogName.size() >= 1
        && request.resource.data.dogName.size() <= 40
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 1
        && request.resource.data.description.size() <= 300
        && request.resource.data.photoPath
          == 'mischief-posts/' + request.auth.uid + '/' + postId + '.jpg'
        && request.resource.data.photoUrl is string
        && request.resource.data.innocentVotes == 0
        && request.resource.data.guiltyVotes == 0
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;

      match /votes/{userId} {
        allow read, write: if false;
      }
    }

    match /mischiefReports/{reportId} {
      allow get, list: if isAdmin();
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.uid == request.resource.data.reporterUid
        && request.resource.data.keys().hasOnly([
          'postId', 'reporterUid', 'createdAt'
        ])
        && request.resource.data.postId is string
        && request.resource.data.postId.size() >= 20
        && request.resource.data.postId.size() <= 80
        && reportId == request.resource.data.postId + '_'
          + request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /packLegacyProfiles/{profileId} {
      allow get, list: if isAdmin() || resource.data.published == true;
      allow create: if isAdmin()
        && validPackLegacyProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin()
        && validPackLegacyProfile(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'memberName', 'petName', 'petBreed', 'story', 'achievements',
          'experienceTitle', 'experienceDescription', 'photoUrl',
          'published', 'updatedAt'
        ])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /coffeePupProfiles/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if request.auth != null
        && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'email', 'displayName', 'firstName', 'lastName', 'username',
          'role', 'createdAt', 'birthDate', 'isVerified',
          'birthdayMarketingConsent', 'birthdayConsentUpdatedAt',
          'phoneNumber', 'phoneCountryCode', 'phoneCountryIsoCode',
          'phoneNationalNumber', 'phoneVerified', 'messageCredits',
          'messageCreditsUpdatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'email', 'displayName', 'createdAt', 'isVerified'
        ])
        && request.resource.data.isVerified == false
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.createdAt == request.time
        && (
          !('birthdayMarketingConsent' in request.resource.data)
          && !('birthdayConsentUpdatedAt' in request.resource.data)
          || request.resource.data.birthdayMarketingConsent is bool
            && request.resource.data.birthdayConsentUpdatedAt == request.time
        )
        && (
          !('messageCredits' in request.resource.data)
          && !('messageCreditsUpdatedAt' in request.resource.data)
          || request.resource.data.messageCredits is int
            && request.resource.data.messageCredits == 10
            && request.resource.data.messageCreditsUpdatedAt == request.time
        )
        && (
          request.auth.token.firebase.sign_in_provider == 'anonymous'
          || (
            request.resource.data.keys().hasAll([
              'firstName', 'lastName', 'username', 'role', 'birthDate',
              'phoneNumber', 'phoneCountryCode', 'phoneCountryIsoCode',
              'phoneNationalNumber', 'phoneVerified',
              'birthdayMarketingConsent', 'birthdayConsentUpdatedAt'
            ])
            && request.resource.data.role == 'user'
            && request.resource.data.firstName is string
            && request.resource.data.firstName.size() > 0
            && request.resource.data.firstName.size() <= 60
            && request.resource.data.lastName is string
            && request.resource.data.lastName.size() > 0
            && request.resource.data.lastName.size() <= 60
            && request.resource.data.displayName
              == request.resource.data.firstName + ' '
                + request.resource.data.lastName
            && request.resource.data.birthdayMarketingConsent is bool
            && request.resource.data.birthdayConsentUpdatedAt == request.time
            && request.resource.data.username is string
            && request.resource.data.username.matches('^[a-zA-Z0-9._-]{3,20}$')
            && existsAfter(
              /databases/$(database)/documents/usernameRegistry/$(request.resource.data.username.lower())
            )
            && getAfter(
              /databases/$(database)/documents/usernameRegistry/$(request.resource.data.username.lower())
            ).data.uid == userId
            && getAfter(
              /databases/$(database)/documents/usernameRegistry/$(request.resource.data.username.lower())
            ).data.role == 'user'
            && request.resource.data.birthDate is string
            && request.resource.data.birthDate.matches(
              '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
            )
            && request.resource.data.phoneNumber is string
            && request.resource.data.phoneNumber.matches(
              '^[+][1-9][0-9]{6,14}$'
            )
            && request.resource.data.phoneCountryCode is string
            && request.resource.data.phoneCountryCode.matches(
              '^[+][1-9][0-9]{0,3}$'
            )
            && request.resource.data.phoneCountryIsoCode is string
            && request.resource.data.phoneCountryIsoCode.matches(
              '^[A-Z]{2}$'
            )
            && request.resource.data.phoneNationalNumber is string
            && request.resource.data.phoneNationalNumber.matches(
              '^[0-9]{7,15}$'
            )
            && request.resource.data.phoneNumber
              == request.resource.data.phoneCountryCode
                + request.resource.data.phoneNationalNumber
            && request.resource.data.phoneVerified == false
          )
        );

      allow update: if (
          request.auth != null
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['email', 'displayName', 'username'])
          && request.resource.data.email == request.auth.token.email
          && (
            !('birthDate' in request.resource.data)
            || request.resource.data.birthDate is string
              && request.resource.data.birthDate.matches(
                '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
              )
          )
          && (
            !('username' in request.resource.data)
            || request.resource.data.username is string
              && request.resource.data.username.matches(
                '^[a-zA-Z0-9._-]{3,20}$'
              )
              && existsAfter(
                /databases/$(database)/documents/usernameRegistry/$(request.resource.data.username.lower())
              )
              && getAfter(
                /databases/$(database)/documents/usernameRegistry/$(request.resource.data.username.lower())
              ).data.uid == userId
              && getAfter(
                /databases/$(database)/documents/usernameRegistry/$(request.resource.data.username.lower())
              ).data.role == 'user'
          )
        ) || (
          request.auth != null
              && request.auth.uid == userId
              && request.auth.token.email_verified == true
              && (
                resource.data.birthDate is string
                || resource.data.birthDate is timestamp
                || resource.data.dateOfBirth is string
                || resource.data.dateOfBirth is timestamp
              )
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  'birthdayMarketingConsent', 'birthdayConsentUpdatedAt'
                ])
              && request.resource.data.birthdayMarketingConsent is bool
              && request.resource.data.birthdayConsentUpdatedAt == request.time
        ) || (
          request.auth != null
          && request.auth.uid == userId
          && request.auth.token.email_verified == true
          && !('birthDate' in resource.data)
          && !('dateOfBirth' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'birthDate', 'birthdayMarketingConsent',
              'birthdayConsentUpdatedAt'
            ])
          && request.resource.data.birthDate is string
          && request.resource.data.birthDate.matches(
            '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
          )
          && request.resource.data.birthdayMarketingConsent is bool
          && request.resource.data.birthdayConsentUpdatedAt == request.time
        ) || (
              request.auth != null
          && request.auth.uid == userId
          && !('messageCredits' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['messageCredits', 'messageCreditsUpdatedAt'])
          && request.resource.data.messageCredits is int
          && request.resource.data.messageCredits == 10
          && request.resource.data.messageCreditsUpdatedAt == request.time
        ) || (
          request.auth != null
          && request.auth.uid == userId
          && resource.data.messageCredits is int
          && resource.data.messageCredits > 0
          && request.resource.data.messageCredits
            == resource.data.messageCredits - 1
          && request.resource.data.messageCreditsUpdatedAt == request.time
          && request.resource.data.lastChatMessageId is string
          && request.resource.data.lastChatMessageId.matches(
            '^[A-Za-z0-9_-]{8,80}$'
          )
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'messageCredits', 'messageCreditsUpdatedAt', 'lastChatMessageId'
            ])
          && existsAfter(
            /databases/$(database)/documents/users/$(userId)/chatMessages/$(request.resource.data.lastChatMessageId)
          )
          && getAfter(
            /databases/$(database)/documents/users/$(userId)/chatMessages/$(request.resource.data.lastChatMessageId)
          ).data.createdAt == request.time
          && getAfter(
            /databases/$(database)/documents/users/$(userId)/chatMessages/$(request.resource.data.lastChatMessageId)
          ).data.text is string
        ) || (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['role', 'rol', 'email', 'displayName'])
          && request.resource.data.get(
            'role',
            request.resource.data.get('rol', '')
          ) in [
            'user', 'cliente', 'barista', 'cajero', 'admin', 'gerente'
          ]
        );

      allow delete: if isAdmin();

      match /chatMessages/{messageId} {
        allow get, list: if request.auth != null
          && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && messageId.matches('^[A-Za-z0-9_-]{8,80}$')
          && request.resource.data.keys().hasOnly([
            'text', 'matchProfileId', 'matchName', 'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'text', 'matchProfileId', 'matchName', 'createdAt'
          ])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.matchProfileId is string
          && request.resource.data.matchProfileId.matches(
            '^[A-Za-z0-9_-]{1,80}$'
          )
          && request.resource.data.matchName is string
          && request.resource.data.matchName.size() > 0
          && request.resource.data.matchName.size() <= 80
          && request.resource.data.createdAt == request.time
          && exists(
            /databases/$(database)/documents/users/$(userId)
          )
          && get(
            /databases/$(database)/documents/users/$(userId)
          ).data.messageCredits is int
          && get(
            /databases/$(database)/documents/users/$(userId)
          ).data.messageCredits > 0
          && getAfter(
            /databases/$(database)/documents/users/$(userId)
          ).data.messageCredits
            == get(
              /databases/$(database)/documents/users/$(userId)
            ).data.messageCredits - 1
          && getAfter(
            /databases/$(database)/documents/users/$(userId)
          ).data.lastChatMessageId == messageId;
        allow update, delete: if false;
      }

      match /pushTokens/{tokenHash} {
        allow read: if false;

        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.auth.token.email_verified == true
          && (databaseRole() in ['barista', 'cajero'] || isAdmin())
          && tokenHash.matches('^[a-f0-9]{64}$')
          && request.resource.data.keys().hasOnly([
            'token', 'platform', 'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'token', 'platform', 'updatedAt'
          ])
          && request.resource.data.token is string
          && request.resource.data.token.size() >= 100
          && request.resource.data.token.size() <= 4096
          && request.resource.data.platform == 'web'
          && request.resource.data.updatedAt == request.time;

        allow update: if request.auth != null
          && request.auth.uid == userId
          && request.auth.token.email_verified == true
          && (databaseRole() in ['barista', 'cajero'] || isAdmin())
          && tokenHash.matches('^[a-f0-9]{64}$')
          && request.resource.data.keys().hasOnly([
            'token', 'platform', 'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'token', 'platform', 'updatedAt'
          ])
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['token', 'platform', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() >= 100
          && request.resource.data.token.size() <= 4096
          && request.resource.data.platform == 'web'
          && request.resource.data.updatedAt == request.time;

        allow delete: if request.auth != null
          && request.auth.uid == userId
          && request.auth.token.email_verified == true
          && (databaseRole() in ['barista', 'cajero'] || isAdmin());
      }

      match /bitacora/{code} {
        allow get, list: if request.auth != null
          && request.auth.uid == userId;

        allow create: if request.auth != null
          && request.auth.uid == userId
          && code.matches('^CW-(PLUSH-00[1-9]|CUP-00[7-9])-[0-9]{4}$')
          && request.resource.data.keys().hasOnly([
            'nickname', 'notes', 'isFavorite', 'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'nickname', 'notes', 'isFavorite', 'updatedAt'
          ])
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() <= 40
          && request.resource.data.notes is string
          && request.resource.data.notes.size() <= 500
          && request.resource.data.isFavorite is bool
          && request.resource.data.updatedAt == request.time
          && exists(
            /databases/$(database)/documents/collectiblePlushes/$(code)
          )
          && get(
            /databases/$(database)/documents/collectiblePlushes/$(code)
          ).data.claimedBy == userId;

        allow update: if request.auth != null
          && request.auth.uid == userId
          && code.matches('^CW-(PLUSH-00[1-9]|CUP-00[7-9])-[0-9]{4}$')
          && request.resource.data.keys().hasOnly([
            'nickname', 'notes', 'isFavorite', 'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'nickname', 'notes', 'isFavorite', 'updatedAt'
          ])
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['nickname', 'notes', 'isFavorite', 'updatedAt'])
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() <= 40
          && request.resource.data.notes is string
          && request.resource.data.notes.size() <= 500
          && request.resource.data.isFavorite is bool
          && request.resource.data.updatedAt == request.time
          && exists(
            /databases/$(database)/documents/collectiblePlushes/$(code)
          )
          && get(
            /databases/$(database)/documents/collectiblePlushes/$(code)
          ).data.claimedBy == userId;

        allow delete: if false;
      }

      match /challengeProgress/{challengeId} {
        allow get, list: if request.auth != null
          && request.auth.uid == userId;

        allow create: if request.auth != null
          && request.auth.uid == userId
          && challengeId in [
            'daily_pet_coffee',
            'visit_5_coffee_wolves',
            'try_3_coffee_methods',
            'bring_a_friend'
          ]
          && request.resource.data.keys().hasOnly([
            'challengeId', 'title', 'status', 'completedAt', 'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'challengeId', 'title', 'status', 'completedAt', 'updatedAt'
          ])
          && request.resource.data.challengeId == challengeId
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 120
          && request.resource.data.status == 'self_reported'
          && request.resource.data.completedAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update, delete: if false;
      }

      match /friendRequests/{requesterUid} {
        allow get, list: if request.auth != null
          && request.auth.uid == userId;

        allow create: if request.auth != null
          && request.auth.uid == requesterUid
          && requesterUid != userId
          && exists(
            /databases/$(database)/documents/users/$(userId)
          )
          && request.resource.data.keys().hasOnly([
            'fromUid', 'fromDisplayName', 'status', 'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'fromUid', 'fromDisplayName', 'status', 'createdAt'
          ])
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.fromDisplayName is string
          && request.resource.data.fromDisplayName.size() <= 80
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;

        allow update: if request.auth != null
          && requesterUid != userId
          && (
            request.auth.uid == userId
            && resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'decidedAt', 'decidedBy'])
            && request.resource.data.status in ['accepted', 'rejected']
            && request.resource.data.decidedAt == request.time
            && request.resource.data.decidedBy == request.auth.uid
            || request.auth.uid == requesterUid
              && resource.data.fromUid == request.auth.uid
              && resource.data.status == 'rejected'
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['fromDisplayName', 'status', 'createdAt'])
              && request.resource.data.fromDisplayName is string
              && request.resource.data.fromDisplayName.size() <= 80
              && request.resource.data.status == 'pending'
              && request.resource.data.createdAt == request.time
          );

        allow delete: if false;
      }

      match /friends/{friendUid} {
        allow get, list: if request.auth != null
          && request.auth.uid == userId;

        allow create: if request.auth != null
          && request.auth.uid == friendUid
          && friendUid != userId
          && request.resource.data.keys().hasOnly([
            'displayName', 'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'displayName', 'createdAt'
          ])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 80
          && request.resource.data.createdAt == request.time
          && getAfter(
            /databases/$(database)/documents/users/$(friendUid)/friendRequests/$(userId)
          ).data.status == 'accepted'
          && getAfter(
            /databases/$(database)/documents/users/$(friendUid)/friendRequests/$(userId)
          ).data.decidedBy == request.auth.uid;

        allow update, delete: if false;
      }
    }

    match /memberCards/{userId} {
      allow get: if request.auth != null
        && (request.auth.uid == userId || isVerifiedStaff() || isAdmin());
      allow list: if isAdmin();

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'userUid', 'cardNumber', 'sequence', 'createdAt'
        ])
        && request.resource.data.userUid == userId
        && request.resource.data.cardNumber is string
        && request.resource.data.cardNumber.matches('^CW-[0-9]{6}$')
        && request.resource.data.sequence is int
        && request.resource.data.sequence > 0
        && request.resource.data.createdAt == request.time
        && getAfter(
          /databases/$(database)/documents/memberCardLookups/$(request.resource.data.cardNumber)
        ).data.userUid == userId
        && getAfter(
          /databases/$(database)/documents/memberCardLookups/$(request.resource.data.cardNumber)
        ).data.sequence == request.resource.data.sequence
        && getAfter(
          /databases/$(database)/documents/memberCardCounters/current
        ).data.lastSequence == request.resource.data.sequence;

      allow update, delete: if false;
    }

    match /memberCardLookups/{cardNumber} {
      allow get: if isVerifiedStaff() || isAdmin();
      allow list: if false;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'userUid', 'cardNumber', 'sequence', 'createdAt'
        ])
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.cardNumber == cardNumber
        && cardNumber.matches('^CW-[0-9]{6}$')
        && request.resource.data.sequence is int
        && request.resource.data.sequence > 0
        && request.resource.data.createdAt == request.time
        && getAfter(
          /databases/$(database)/documents/memberCards/$(request.auth.uid)
        ).data.cardNumber == cardNumber
        && getAfter(
          /databases/$(database)/documents/memberCards/$(request.auth.uid)
        ).data.sequence == request.resource.data.sequence
        && getAfter(
          /databases/$(database)/documents/memberCardCounters/current
        ).data.lastSequence == request.resource.data.sequence;

      allow update, delete: if false;
    }

    match /memberCardCounters/{counterId} {
      allow get: if request.auth != null && counterId == 'current';
      allow list: if false;

      allow create: if request.auth != null
        && counterId == 'current'
        && request.resource.data.keys().hasOnly(['lastSequence'])
        && request.resource.data.lastSequence == 1
        && memberCardLookupMatches(request.auth.uid, 1);

      allow update: if request.auth != null
        && counterId == 'current'
        && request.resource.data.keys().hasOnly(['lastSequence'])
        && resource.data.lastSequence is int
        && request.resource.data.lastSequence == resource.data.lastSequence + 1
        && memberCardLookupMatches(
          request.auth.uid,
          request.resource.data.lastSequence
        );

      allow delete: if false;
    }

    match /customers/{customerId} {
      allow get, list: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'fullName', 'phone', 'nationalId', 'email', 'memberCardNumber',
          'sequence', 'createdBy', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'fullName', 'phone', 'nationalId', 'email', 'memberCardNumber',
          'sequence', 'createdBy', 'createdAt'
        ])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 8
        && request.resource.data.phone.size() <= 24
        && request.resource.data.phone.matches(
          '^([+][0-9]{8,15}|[0-9]{8,15})$'
        )
        && request.resource.data.nationalId is string
        && request.resource.data.nationalId.size() >= 4
        && request.resource.data.nationalId.size() <= 32
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && request.resource.data.memberCardNumber is string
        && request.resource.data.memberCardNumber.matches('^CW-M-[0-9]{6}$')
        && request.resource.data.sequence is int
        && request.resource.data.sequence > 0
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(
          /databases/$(database)/documents/customerMemberCardLookups/$(request.resource.data.memberCardNumber)
        ).data.customerId == customerId
        && getAfter(
          /databases/$(database)/documents/customerMemberCardCounters/current
        ).data.lastSequence == request.resource.data.sequence
        && getAfter(
          /databases/$(database)/documents/customerMemberCardCounters/current
        ).data.lastCardNumber == request.resource.data.memberCardNumber;

      allow update, delete: if isAdmin();
    }

    match /member_cards/{holderId} {
      allow get, list: if isAdmin();

